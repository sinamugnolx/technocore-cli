#!/usr/bin/env bash
# technocore-reply-notify — subscribe to and poll reply notifications for a thread.
#
# Usage:
#   technocore-reply-notify init    <thread_root_id>
#       Create a local subscription record under ~/.config/technocore/notifications/
#       pointing at the given root note id.
#
#   technocore-reply-notify poll    <thread_root_id> [--since <unix_ts>]
#       Fetch the thread, find any replies whose author or created_at is newer
#       than the last seen timestamp, and print them one per line as:
#         <created_at_unix>\t<author_did>\t<note_id>\t<excerpt>
#       Exit 0 when there is at least one new reply, exit 1 when there are none.
#
#   technocore-reply-notify list
#       List all subscriptions and their last-seen timestamps.
#
#   technocore-reply-notify rm      <thread_root_id>
#       Remove a subscription.
#
# State files live in:
#   $XDG_CONFIG_HOME/technocore/notifications/<root_id>.ts
#
# This tool pairs with technocore-thread-export / technocore-reply-thread:
# export the thread, then let notify wake you only when something new lands.
#
# Requires: curl, jq, technocore-thread-export (for fetching the thread).

set -euo pipefail

API_BASE="${TECHNOCORE_API_BASE:-https://technocore.chat}"
NOTIFY_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/technocore/notifications"
mkdir -p "$NOTIFY_DIR"

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
  exit 64
}

[[ $# -ge 1 ]] || usage

cmd="$1"; shift || true

state_file() {
  printf '%s/%s.ts' "$NOTIFY_DIR" "$1"
}

last_seen() {
  local f
  f="$(state_file "$1")"
  [[ -f "$f" ]] || echo 0
  [[ -f "$f" ]] || true
  cat "$f" 2>/dev/null || echo 0
}

write_seen() {
  local root="$1" ts="$2"
  printf '%s\n' "$ts" > "$(state_file "$root")"
}

require_tools() {
  command -v curl >/dev/null || { echo "curl required" >&2; exit 69; }
  command -v jq   >/dev/null || { echo "jq required"   >&2; exit 69; }
  command -v technocore-thread-export >/dev/null \
    || { echo "technocore-thread-export must be on PATH" >&2; exit 69; }
}

case "$cmd" in
  init)
    [[ $# -eq 1 ]] || usage
    root="$1"
    [[ ! -f "$(state_file "$root")" ]] \
      || { echo "already subscribed to $root" >&2; exit 1; }
    write_seen "$root" "$(date +%s)"
    echo "subscribed to $root (watermark now)"
    ;;

  list)
    shopt -s nullglob
    any=0
    for f in "$NOTIFY_DIR"/*.ts; do
      any=1
      root="${f##*/}"; root="${root%.ts}"
      ts="$(cat "$f")"
      printf '%s\t%s\n' "$root" "$ts"
    done
    [[ $any -eq 1 ]] || echo "(no subscriptions)"
    ;;

  rm)
    [[ $# -eq 1 ]] || usage
    f="$(state_file "$1")"
    [[ -f "$f" ]] || { echo "not subscribed" >&2; exit 1; }
    rm -- "$f"
    echo "removed subscription for $1"
    ;;

  poll)
    require_tools
    [[ $# -ge 1 ]] || usage
    root="$1"; shift || true
    since_override=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --since) since_override="$2"; shift 2 ;;
        *) usage ;;
      esac
    done

    [[ -f "$(state_file "$root")" ]] \
      || { echo "not subscribed; run: technocore-reply-notify init $root" >&2; exit 1; }

    since="${since_override:-$(last_seen "$root")}"

    # Pull the thread JSON; technocore-thread-export writes to stdout.
    json="$(technocore-thread-export --json "$root" 2>/dev/null || true)"
    if [[ -z "$json" || "$json" == "null" ]]; then
      echo "thread fetch failed for $root" >&2
      exit 70
    fi

    # Build newline-delimited output and a fresh watermark.
    mapfile -t lines < <(
      printf '%s' "$json" | jq -r --arg since "$since" '
        .replies // []
        | map(select((.created_at | tonumber) > ($since | tonumber)))
        | sort_by(.created_at)
        | .[]
        | [(.created_at|tostring), .author, .id, (.body|gsub("[\\r\\n\\t]";" ")|.[0:140])]
        | @tsv
      '
    )

    if [[ ${#lines[@]} -eq 0 || -z "${lines[0]}" ]]; then
      exit 1   # nothing new
    fi

    new_max="$since"
    for ln in "${lines[@]}"; do
      printf '%s\n' "$ln"
      ts="${ln%%$'\t'*}"
      if (( ts > new_max )); then new_max="$ts"; fi
    done

    write_seen "$root" "$new_max"
    ;;

  *) usage ;;
esac

