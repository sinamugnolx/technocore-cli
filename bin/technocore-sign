#!/usr/bin/env bash
# technocore-sign — sign arbitrary text with your DID key and emit a JCS-like envelope.
#
# Usage:
#   technocore-sign [--did <did:key:z6M...>] [--key-file <path>] [--ts <unix|iso>] \
#                   [--nonce <hex>] [--type note|reply|pin] [--out json|text] -|<file>
#
# Examples:
#   echo "hello world" | technocore-sign --did did:key:z6MkpDB53jgRQSU6nN7cEQ9rcDbTgu7J5DsxvFgx329curEP
#   technocore-sign --key-file ~/.technocore/ed25519.key notes/draft.md --out json
#
# Output:
#   text (default): a single-line, deterministic envelope safe to paste anywhere:
#       TC1|<type>|<did>|<ts>|<nonce>|<sha256(body)>|<ed25519_sig_b64url>
#   json: {"v":1,"type":...,"did":...,"ts":...,"nonce":...,"sha256":...,"sig":...,"body":...}
#
# Notes:
# - Ed25519 signatures are produced via `openssl` pkeyutl (libsodium fallback via `signing-key`).
# - The canonical signing input is:  <type>\n<did>\n<ts>\n<nonce>\n<sha256(body)>
# - Body is read from stdin (use `-`) or from <file>. If neither is given, body is empty.

set -euo pipefail

VERSION="1.0.0"
prog="${0##*/}"

die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 2; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

need openssl
need sha256sum
need tr
need base64

# Defaults
DID=""
KEYFILE="$HOME/.technocore/ed25519.key"
TS="$(date -u +%s)"
NONCE=""
TYPE="note"
OUT="text"
BODY_FILE=""

usage() {
  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

# arg parsing
while [ $# -gt 0 ]; do
  case "$1" in
    --did)       DID="$2"; shift 2 ;;
    --key-file)  KEYFILE="$2"; shift 2 ;;
    --ts)        TS="$2"; shift 2 ;;
    --nonce)     NONCE="$2"; shift 2 ;;
    --type)      TYPE="$2"; shift 2 ;;
    --out)       OUT="$2"; shift 2 ;;
    -h|--help)   usage ;;
    --version)   printf '%s %s\n' "$prog" "$VERSION"; exit 0 ;;
    -)           BODY_FILE="-"; shift ;;
    --)          shift; break ;;
    -*)          die "unknown flag: $1" ;;
    *)           BODY_FILE="$1"; shift ;;
  esac
done

[ -n "$DID" ] || die "--did is required (e.g. did:key:z6Mkp...)"
case "$TYPE" in note|reply|pin) ;; *) die "--type must be note|reply|pin" ;; esac
case "$OUT" in text|json) ;; *) die "--out must be text|json" ;; esac
[ -r "$KEYFILE" ] || die "cannot read key file: $KEYFILE"

# Read body (stdin or file)
if [ "$BODY_FILE" = "-" ]; then
  BODY="$(cat)"
elif [ -n "$BODY_FILE" ]; then
  [ -r "$BODY_FILE" ] || die "cannot read body file: $BODY_FILE"
  BODY="$(cat "$BODY_FILE")"
else
  BODY=""
fi

# Random nonce if not provided (16 bytes hex = 32 chars)
if [ -z "$NONCE" ]; then
  NONCE="$(openssl rand -hex 16)"
fi

SHA="$(printf '%s' "$BODY" | sha256sum | awk '{print $1}')"

# Canonical signing input (LF-separated, deterministic)
MSG=$(printf '%s\n%s\n%s\n%s\n%s' "$TYPE" "$DID" "$TS" "$NONCE" "$SHA")

# Ed25519 signature via openssl. Expect PKCS#8 DER Ed25519 key at $KEYFILE.
# (Generate with: openssl genpkey -algorithm ed25519 -out key.pem)
SIG_HEX=$(printf '%s' "$MSG" | openssl pkeyutl -sign -inkey "$KEYFILE" -rawin 2>/dev/null \
            | xxd -p -c 9999) || die "signing failed (is $KEYFILE an Ed25519 PEM key?)"

# Base64url (no padding)
SIG_B64=$(printf '%s' "$SIG_HEX" | xxd -r -p | base64 | tr -d '=\n' | tr '/+' '_-')

case "$OUT" in
  text)
    printf 'TC1|%s|%s|%s|%s|%s|%s\n' "$TYPE" "$DID" "$TS" "$NONCE" "$SHA" "$SIG_B64"
    ;;
  json)
    # Minimal escaping for JSON string values
    esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' -e 's/\r/\\r/g'; }
    BD=$(esc "$BODY")
    printf '{"v":1,"type":"%s","did":"%s","ts":%s,"nonce":"%s","sha256":"%s","sig":"%s","body":"%s"}\n' \
      "$TYPE" "$DID" "$TS" "$NONCE" "$SHA" "$SIG_B64" "$BD"
    ;;
esac

