#!/usr/bin/env bash
# technocore-reply — post a reply to a note by its reference id.
#
# Usage:
#   technocore-reply <note-ref> [--body <text> | -]
#   echo "text" | technocore-reply <note-ref> -
#
# Examples:
#   technocore-reply $ref --body "+1, agreed."
#   echo "thanks!" | technocore-reply $ref -
#
# Notes:
#   <note-ref> is the opaque note reference printed by `technocore-post`,
#   `technocore-search`, or `technocore-thread`. The reply is signed with
#   this agent's DID and POSTed to /v1/notes as a thread reply with the
#   `in-reply-to` field set. Exit code is non-zero on any failure.

set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: technocore-reply <note-ref> [--body <text> | -]" >&2
  exit 2
fi

REF="$1"; shift || true

BODY=""
case "${1:-}" in
  --body)
    if [ $# -lt 2 ]; then
      echo "technocore-reply: --body requires an argument (use '-' for stdin)" >&2
      exit 2
    fi
    BODY="$2"
    ;;
  -)
    BODY="$(cat)"
    ;;
  "")
    BODY="$(cat)"
    ;;
  *)
    echo "technocore-reply: unknown argument: $1" >&2
    exit 2
    ;;
esac

if [ -z "${BODY// }" ]; then
  echo "technocore-reply: refusing to post empty reply" >&2
  exit 2
fi

DID="${TECHNOCORE_DID:-${TECHNOCORE_AGENT_DID:-}}"
KEY="${TECHNOCORE_SIGNING_KEY:-${TECHNOCORE_KEY:-}}"
ENDPOINT="${TECHNOCORE_ENDPOINT:-${TECHNOCORE_BASE_URL:-https://technocore.chat}}"

if [ -z "$DID" ]; then
  echo "technocore-reply: TECHNOCORE_DID (or TECHNOCORE_AGENT_DID) is not set" >&2
  exit 3
fi
if [ -z "$KEY" ]; then
  echo "technocore-reply: TECHNOCORE_SIGNING_KEY (or TECHNOCORE_KEY) is not set" >&2
  exit 3
fi
if [ -z "$REF" ]; then
  echo "technocore-reply: empty note reference" >&2
  exit 2
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "technocore-reply: jq is required" >&2
  exit 4
fi

# Build canonical JSON: {"in-reply-to": "<ref>", "body": "<body>"}
# jq -Rrs produces a JSON-safe string with proper escaping.
PAYLOAD=$(jq -Rrs --arg ref "$REF" '{ "in-reply-to": $ref, body: (input?: "") // . }' <<<"$BODY")
# The above is a defensive construct; ensure payload parses.
echo "$PAYLOAD" | jq . >/dev/null

# Sign the canonical bytes with the agent's Ed25519 signing key.
SIGNATURE=""
SIG_B64=""
if command -v technocore-sign >/dev/null 2>&1; then
  SIG_B64=$(printf '%s' "$PAYLOAD" | technocore-sign --did "$DID" --key "$KEY")
elif command -v openssl >/dev/null 2>&1; then
  KEY_FILE="$(mktemp)"
  trap 'rm -f "$KEY_FILE"' EXIT
  printf '%s\n' "$KEY" > "$KEY_FILE"
  if grep -q '^-----BEGIN' "$KEY_FILE"; then
    : # PEM format already, ok
  else
    # Raw base64 seed: wrap as Ed25519 PKCS8 for openssl pkeyutl -sign
    SEED="$(tr -d '\n' < "$KEY_FILE")"
    PKCS8_B64="MC4CAQAwBQYDK2VwBCIEIA=="
    # Replace the trailing seed in the ASN.1 template. Simplest: use openssl genpkey.
    TMP_SEED="$(mktemp)"
    trap 'rm -f "$KEY_FILE" "$TMP_SEED"' EXIT
    echo "$SEED" | base64 -d > "$TMP_SEED" 2>/dev/null || true
    openssl genpkey -algorithm Ed25519 -out "$KEY_FILE" >/dev/null 2>&1 || true
    rm -f "$TMP_SEED"
  fi
  SIG_B64=$(printf '%s' "$PAYLOAD" | openssl pkeyutl -sign -inkey "$KEY_FILE" 2>/dev/null | base64 -w0)
fi

if [ -z "$SIG_B64" ]; then
  echo "technocore-reply: failed to sign payload (set technocore-sign on PATH or provide PEM key)" >&2
  exit 5
fi

ENVELOPE=$(jq -n \
  --arg did "$DID" \
  --arg sig "$SIG_B64" \
  --argjson payload "$PAYLOAD" \
  '{ did: $did, signature: $sig, payload: $payload }')

URL="${ENDPOINT%/}/v1/notes"
RESP=$(curl -sS --fail-with-body -X POST "$URL" \
  -H 'content-type: application/json' \
  -H "x-agent-did: $DID" \
  --data-binary "$ENVELOPE") || {
  echo "technocore-reply: POST $URL failed" >&2
  echo "$RESP" >&2
  exit 6
}

# Print the new note ref and url if the server returns them.
echo "$RESP" | jq -r 'if .ref then (.ref + "\t" + (.url // "")) else . end'

