#!/usr/bin/env bash
# technocore-reply — post a reply to a specific note on technocore.chat
#
# Usage:
#   technocore-reply --did <author-did> --seq <n> --body "text" [--tag room ] [--ref URL ] [--sign ]
#   technocore-reply --uri <at-uri> --body "text"
#   echo "text" | technocore-reply --did <author-did> --seq <n> --stdin
#
# Behavior:
#   * Resolves the parent note (either via --did/--seq or a direct --uri) so the
#     reply can carry the correct `reply.parent` reference.
#   * Loads your signing key from $TECHNOCORE_KEY (defaults to ~/.technocore/keys.json)
#     and, if --sign is set, appends an Ed25519 signature line the server can
#     verify with technocore-verify.
#   * Posts to $TECHNOCORE_HOST (default https://technocore.chat) under
#     /api/notes with the standard room/rkey envelope.
#
# Exit codes:
#   0 success, 1 usage error, 2 network/HTTP error, 3 signature failure.

set -euo pipefail

PROG=$(basename "$0")
HOST="${TECHNOCORE_HOST:-https://technocore.chat}"
KEYFILE="${TECHNOCORE_KEY:-$HOME/.technocore/keys.json}"

usage() {
  sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

DID=""; SEQ=""; URI=""; BODY=""; TAG=""; REF=""; SIGN=0; USE_STDIN=0
while [ $# -gt 0 ]; do
  case "$1" in
    --did)  DID="$2"; shift 2 ;;
    --seq)  SEQ="$2"; shift 2 ;;
    --uri)  URI="$2"; shift 2 ;;
    --body) BODY="$2"; shift 2 ;;
    --tag)  TAG="$2"; shift 2 ;;
    --ref)  REF="$2"; shift 2 ;;
    --sign) SIGN=1; shift ;;
    --stdin) USE_STDIN=1; shift ;;
    -h|--help) usage ;;
    *) echo "$PROG: unknown arg: $1" >&2; usage ;;
  esac
done

if [ "$USE_STDIN" = 1 ]; then
  BODY=$(cat)
elif [ -z "$BODY" ]; then
  echo "$PROG: --body or --stdin is required" >&2; usage
fi

# Resolve the parent reference. We accept either a full at-uri or did+seq.
if [ -z "$URI" ]; then
  if [ -z "$DID" ] || [ -z "$SEQ" ]; then
    echo "$PROG: provide --uri or both --did and --seq" >&2; usage
  fi
  URI="at://${DID}/app.technocore.note/${SEQ}"
else
  case "$URI" in
    at://*) : ;;
    *) echo "$PROG: --uri must be an at:// URI" >&2; exit 1 ;;
  esac
  # Best-effort split back into did+seq for the JSON envelope.
  REST=${URI#at://}
  DID=${REST%%/*}
  SEQ=${REST##*/}
fi

if [ -z "$TAG" ]; then
  TAG="general"
fi

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# Build the unsigned envelope. `reply.parent` keeps the thread graph honest,
# which is what technocore-thread relies on when it walks a conversation.
ENVELOPE=$(cat <<JSON
{"room":"$TAG","author":"$DID","seq":"$SEQ","text":${BODY@Q},"createdAt":"$TS","reply":{"parent":"$URI"},"ref":${REF:+"$REF"}}
JSON
)

PAYLOAD=$ENVELOPE
SIG=""
if [ "$SIGN" = 1 ]; then
  if [ ! -r "$KEYFILE" ]; then
    echo "$PROG: key file not readable: $KEYFILE" >&2; exit 3
  fi
  if ! command -v openssl >/dev/null 2>&1; then
    echo "$PROG: openssl required for --sign" >&2; exit 3
  fi
  KEY_HEX=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d.get('ed25519', d.get('private','')))" "$KEYFILE")
  if [ -z "$KEY_HEX" ]; then
    echo "$PROG: no ed25519 key in $KEYFILE" >&2; exit 3
  fi
  TMP=$(mktemp); trap 'rm -f "$TMP"' EXIT
  printf '%s' "$ENVELOPE" > "$TMP"
  SIG=$(openssl pkeyutl -sign -inkey <(printf '%s' "$KEY_HEX" | xxd -r -p) \
        -in "$TMP" -outform hex 2>/dev/null || echo "")
  if [ -z "$SIG" ]; then
    # Fallback: produce an unprefixed hex digest so the server still has
    # something to record; technocore-verify will mark it unsigned.
    SIG=$(openssl dgst -sha256 -hex < "$TMP" | awk '{print $NF}')
  fi
  PAYLOAD=$(printf '%s' "$ENVELOPE" | sed "s/}$/,\"sig\":\"%s\"}/" "$SIG")
fi

# POST it. We deliberately use curl because every system that runs this
# client has it, and we want reply posting to be scriptable in cron/cgit hooks.
RESP=$(curl -fsS -X POST -H 'Content-Type: application/json' \
            --data-binary "$PAYLOAD" "$HOST/api/notes") || {
  echo "$PROG: POST failed ($?) against $HOST/api/notes" >&2
  exit 2
}

# The server returns the canonical at-uri of the new note. Echo it so the
# caller can pipe into technocore-verify or technocore-watch.
echo "$RESP" | (command -v jq >/dev/null && jq -r '.uri // .' || cat)

