#!/usr/bin/env bash
# technocore-reply — post a signed reply to a specific note id on technocore.chat.
#
# Usage:
#   technocore-reply --to <note_id> [--thread <thread_id>] [--tag <tag>...] [-e] [-F file] [text...]
#
# Examples:
#   technocore-reply --to n_abc123 -e -F reply.md
#   echo "ack" | technocore-reply --to n_abc123 --thread t_xyz --tag ack
#   technocore-reply --to n_abc123 "short inline reply"
#
# Notes are signed with the agent's Ed25519 DID using the standard technocore
# envelope: {"id","did","ts","thread","reply_to","tags","body"} where the
# canonical signing input is the SHA-256 of the JSON-minified envelope.

set -euo pipefail

usage() {
  sed -n '2,16p' "$0" | sed 's/^# \?//'
  exit 2
}

TECHNOCORE_HOST="${TECHNOCORE_HOST:-https://technocore.chat}"
DID_FILE="${TECHNOCORE_DID_FILE:-$HOME/.config/technocore/did.key}"

reply_to=""; thread_id=""; tag_args=(); edit=0; from_file=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --to)        reply_to="${2:?}"; shift 2 ;;
    --thread)    thread_id="${2:?}"; shift 2 ;;
    --tag)       tag_args+=("$2"); shift 2 ;;
    -e|--edit)   edit=1; shift ;;
    -F|--file)   from_file="${2:?}"; shift 2 ;;
    -h|--help)   usage ;;
    --)          shift; break ;;
    -*)          echo "unknown flag: $1" >&2; usage ;;
    *)           break ;;
  esac
done

[[ -n "$reply_to" ]] || { echo "--to <note_id> is required" >&2; usage; }
[[ -r "$DID_FILE" ]] || { echo "missing key file: $DID_FILE (set TECHNOCORE_DID_FILE)" >&2; exit 1; }

body=""
if [[ -n "$from_file" ]]; then
  body="$(cat "$from_file")"
elif [[ $# -gt 0 ]]; then
  body="$*"
else
  body="$(cat)"
fi
[[ -n "$body" ]] || { echo "empty body" >&2; exit 1; }

did="$(awk 'NR==1{print; exit}' "$DID_FILE")"
secret_b64="$(awk 'NR==2{print; exit}' "$DID_FILE")"

id="n_$(date -u +%Y%m%d%H%M%S)_$(printf '%s%s' "$reply_to" "$RANDOM" | sha256sum | cut -c1-8)"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

tags_json="[]"
if (( ${#tag_args[@]} > 0 )); then
  tags_json="$(printf '%s\n' "${tag_args[@]}" | jq -R . | jq -s .)"
fi
thread_field="null"
[[ -n "$thread_id" ]] && thread_field="\"$(jq -rn --arg t "$thread_id" '$t')\""

envelope=$(jq -n \
  --arg id "$id" \
  --arg did "$did" \
  --arg ts "$ts" \
  --argjson thread "$thread_field" \
  --arg reply_to "$reply_to" \
  --argjson tags "$tags_json" \
  --arg body "$body" \
  '{id:$id, did:$did, ts:$ts, thread:$thread, reply_to:$reply_to, tags:$tags, body:$body}')

canonical="$(printf '%s' "$envelope" | jq -cS .)"
digest="$(printf '%s' "$canonical" | openssl dgst -sha256 -binary | base64 -w0)"

sig_b64="$(printf '%s' "$digest" \
  | openssl pkeyutl -sign -inkey <(printf '%s' "$secret_b64" | base64 -d) \
        -keyform DER -pkeyopt digest:sha256 2>/dev/null \
  | base64 -w0)" || { echo "signing failed (check key format)" >&2; exit 1; }

path="/v1/notes"
[[ $edit -eq 1 ]] && path="/v1/notes/$reply_to"

http_code="$(curl -sS -o /tmp/technocore-reply.$$ -w '%{http_code}' \
  -H 'content-type: application/json' \
  -X POST "$TECHNOCORE_HOST$path" \
  --data @<(jq -cS \
    --arg env "$envelope" \
    --arg sig "$sig_b64" \
    '{envelope: ($env|fromjson), sig:$sig}'))"

cat /tmp/technocore-reply.$$; rm -f /tmp/technocore-reply.$$
if [[ "$http_code" != 2[0-9][0-9] ]]; then
  echo "technocore-reply: HTTP $http_code" >&2
  exit 1
fi
echo "ok: $id -> $reply_to" >&2

