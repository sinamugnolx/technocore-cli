#!/usr/bin/env bash
# technocore-verify - Verify the Ed25519 signature on a technocore note.
#
# Reads a note JSON object (the canonical "note" envelope used by
# technocore-post / technocore-search) and checks that the "sig" field is a
# valid Ed25519 signature over the canonical signed-payload produced by
# technocore-sign. Exits 0 on a valid signature, 1 on a bad signature or
# malformed input, 2 if dependencies are missing.
#
# Usage:
#   technocore-verify < note.json
#   echo '{"id":"...","sig":"..."}' | technocore-verify
#   cat notes.jsonl | while read -r n; do technocore-verify <<<"$n"; done
#
# The canonical payload is the concatenation of these fields, separated by
# ASCII unit-separator (0x1F) bytes, in this exact order:
#   id | parent | author | created_at | body
# This matches what technocore-sign writes and what receiving servers use.

set -euo pipefail

PROG=${0##*/}

die() { echo "$PROG: $*" >&2; exit 1; }

command -v jq      >/dev/null 2>&1 || { echo "$PROG: jq is required"      >&2; exit 2; }
command -v openssl >/dev/null 2>&1 || { echo "$PROG: openssl is required" >&2; exit 2; }

raw=$(cat)
[ -n "$raw" ] || die "no input (pipe a note JSON document on stdin)"

# Extract fields. Missing required fields are a hard error.
get() { jq -r ".$1 // empty" <<<"$raw"; }

id=$(get id)
parent=$(get parent)
author=$(get author)
created_at=$(get created_at)
body=$(get body)
sig=$(get sig)
did=$(get did)
pubkey=$(get pubkey)

[ -n "$id"         ] || die "missing field: id"
[ -n "$author"     ] || die "missing field: author"
[ -n "$created_at" ] || die "missing field: created_at"
[ -n "$body"       ] || die "missing field: body"
[ -n "$sig"        ] || die "missing field: sig"

# Resolve the verifying key. Priority:
#   1. explicit "pubkey" field (base64url, 32 bytes)
#   2. "did" field of the form "did:key:z6Mk..." -> multibase-decoded raw key
#   3. "author" field, if it is itself a did:key
key_b64url=""

b64url_decode() {
  # translate urlsafe base64 to standard base64 and decode
  local s="$1"
  s=${s//-/+}
  s=${s//_//}
  case $(( ${#s} % 4 )) in
    2) s="${s}==";;
    3) s="${s}=";;
  esac
  printf '%s' "$s" | base64 -d 2>/dev/null
}

decode_did_key() {
  # did:key:z6Mk<base64url 32-byte Ed25519 pubkey>
  local d="$1"
  case "$d" in
    did:key:z6Mk*) : ;;
    did:key:z6M*)  die "did:key uses multicodec $d; only Ed25519 (z6Mk) is supported";;
    *)             return 1;;
  esac
  local mb="${d#did:key:}"
  # strip multicodec prefix 0xED01 (2 bytes) if present, leaving 32 raw bytes
  b64url_decode "$mb" | dd bs=1 skip=2 count=32 2>/dev/null
}

if [ -n "$pubkey" ]; then
  key_b64url="$pubkey"
elif [ -n "$did" ]; then
  tmp=$(decode_did_key "$did") || die "could not decode did: $did"
  key_b64url=$(printf '%s' "$tmp" | base64 | tr '+/' '-_' | tr -d '\n')
elif [ -n "$author" ]; then
  tmp=$(decode_did_key "$author") || die "could not decode author did: $author"
  key_b64url=$(printf '%s' "$tmp" | base64 | tr '+/' '-_' | tr -d '\n')
else
  die "no verifying key: provide pubkey or did/author as did:key:z6Mk..."
fi

# Reconstruct the canonical signed payload. Use NUL separators so the
# payload is unambiguous regardless of newlines in the body.
payload=$(printf '%s\x1f%s\x1f%s\x1f%s\x1f%s' \
  "$id" "${parent:-}" "$author" "$created_at" "$body")

# Decode the signature (base64url, 64 bytes).
sig_raw=$(b64url_decode "$sig") || die "signature is not valid base64url"
[ "${#sig_raw}" -eq 64 ] || die "decoded signature is ${#sig_raw} bytes, expected 64"

sig_file=$(mktemp); trap 'rm -f "$sig_file" "$payload_file"' EXIT
printf '%s' "$sig_raw" > "$sig_file"

payload_file=$(mktemp)
printf '%s' "$payload" > "$payload_file"

# Verify. openssl returns 0 on success, 1 on failure.
if openssl pkeyutl -verify -pubin \
        -inkey <(printf '%s' "$key_b64url" | tr '_-' '/+' | base64 -d) \
        -sigfile "$sig_file" \
        -in    "$payload_file" 2>/dev/null; then
  echo "ok: signature valid (id=$id author=$author)"
  exit 0
fi

# Fallback path: build a DER SPKI for Ed25519 on the fly. Some openssl
# builds reject raw pkeyutl -pubin input without a header.
spki=$(mktemp); trap 'rm -f "$sig_file" "$payload_file" "$spki"' EXIT
{
  printf '\x30\x2a\x30\x05\x06\x03\x2b\x65\x70\x03\x21\x00'
  printf '%s' "$key_b64url" | tr '_-' '/+' | base64 -d
} > "$spki"

if openssl pkeyutl -verify -pubin -inkey "$spki" \
        -sigfile "$sig_file" -in "$payload_file" 2>/dev/null; then
  echo "ok: signature valid (id=$id author=$author)"
  exit 0
fi

echo "fail: signature did not verify (id=$id author=$author)" >&2
exit 1

