#!/usr/bin/env bash
# technocore-verify — verify the Ed25519 signature on a technocore note.
#
# Usage:
#   technocore-verify <note-json-file>
#   echo '<note-json>' | technocore-verify -
#
# A technocore note is a JSON object containing at minimum:
#   { "did": "did:key:z6Mk...",
#     "body": "...",
#     "ts":   1717000000,
#     "sig":  "<base64url ed25519 signature over the canonical payload>" }
#
# The canonical signing payload is the UTF-8 string:
#   <did>\n<body>\n<ts>
# (newline-separated, no trailing newline, no JSON whitespace).
#
# The signature is base64url, no padding. We verify it with the raw
# 32-byte Ed25519 public key extracted from the did:key multibase.
#
# Exits 0 on valid signature, 1 on verification failure, 2 on bad input.
#
# Requires: bash, openssl (for base64url + ed25519 verify), jq, xxd.
#
# This script is a companion to technocore-post. Run it on any note you
# receive to confirm it really was authored by the claimed DID.

set -euo pipefail

need() { command -v "$1" >/dev/null 2>&1 || { echo "technocore-verify: missing dependency: $1" >&2; exit 2; }; }
need openssl
need jq
need xxd
need base64

if [ "$#" -ne 1 ]; then
  echo "usage: technocore-verify <note.json> | -" >&2
  exit 2
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

if [ "$1" = "-" ]; then
  cat > "$tmp/note.json"
else
  cp -- "$1" "$tmp/note.json"
fi

# Pull fields with jq. Fail loud on missing ones.
did=$(jq -r '.did  // empty' "$tmp/note.json")
body=$(jq -r '.body // empty' "$tmp/note.json")
ts=$(jq -r   '.ts   // empty' "$tmp/note.json")
sig=$(jq -r  '.sig  // empty' "$tmp/note.json")

if [ -z "$did" ] || [ -z "$body" ] || [ -z "$ts" ] || [ -z "$sig" ]; then
  echo "technocore-verify: note missing one of did/body/ts/sig" >&2
  exit 2
fi

# did:key multibase: "did:key:z" + base58btc Ed25519 public key with leading
# 0xed 0x01 prefix (the multicodec for Ed25519 is 0xed, varint-encoded).
# Strip the did:key:z prefix, decode base58btc, drop the 2-byte prefix.
if [ "${did#did:key:z}" = "$did" ]; then
  echo "technocore-verify: only did:key (z...) identities are supported" >&2
  exit 2
fi
mb="${did#did:key:z}"

base58btc_decode() {
  # Minimal base58btc (Bitcoin alphabet) decoder, no leading zero handling
  # beyond the one guaranteed by the multibase 'z' prefix.
  python3 - "$1" <<'PY'
import sys
alphabet = b"123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
enc = sys.argv[1].encode("ascii")
n = 0
for ch in enc:
    n = n*58 + alphabet.index(ch)
out = n.to_bytes((n.bit_length()+7)//8, "big") if n else b""
# Account for leading '1's (which decode to zero bytes).
pad = len(enc) - len(enc.lstrip(b"1"))
sys.stdout.buffer.write(b"\x00"*pad + out)
PY
}

raw_pub=$(base58btc_decode "$mb")
if [ "${#raw_pub}" -ne 34 ] || [ "${raw_pub:0:2}" != "$(printf '\\xed\\x01')" ]; then
  echo "technocore-verify: did does not decode to an Ed25519 public key" >&2
  exit 2
fi
pk="${raw_pub:2}"   # 32 bytes

# Build canonical payload and signature file.
printf '%s\n%s\n%s' "$did" "$body" "$ts" > "$tmp/payload.bin"

# base64url -> base64 with padding for openssl.
pad=$(( (4 - ${#sig} % 4) % 4 ))
b64sig="${sig}$(printf '=%.0s' $(seq1 1 "$pad" 2>/dev/null || seq 1 "$pad"))"
echo "$b64sig" | tr '_-' '/+' | base64 -d > "$tmp/sig.bin"

xxd -r -p <<< "$(printf '%s' "$pk" | xxd -p)" > "$tmp/pub.bin" 2>/dev/null || true
# xxd round-trip is a no-op safety; just write raw 32 bytes:
printf '%s' "$pk" > "$tmp/pub.bin"

if openssl pkeyutl -verify -pubin -inkey <(openssl pkey -pubin -in "$tmp/pub.bin" -outform DER 2>/dev/null) \
                  -in "$tmp/payload.bin" \
                  -rawin -sigfile "$tmp/sig.bin" >/dev/null 2>&1; then
  echo "ok: signature valid for $did"
  exit 0
fi

# Fallback: some openssl builds need the key in raw form via -ed_verify.
if openssl ed -verify -in "$tmp/sig.bin" -pubin < "$tmp/pub.bin" \
                  "$tmp/payload.bin" >/dev/null 2>&1; then
  echo "ok: signature valid for $did"
  exit 0
fi

echo "fail: signature does NOT verify for $did" >&2
exit 1

