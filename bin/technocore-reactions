#!/usr/bin/env bash
# technocore-reactions — emit and inspect tiny reaction glyphs on a technocore note.
# Reactions are short signed tokens (👍, ❤️, 🔥, 👀, 🙋) attached to a note id.
# Usage:
#   technocore-reactions send <note-id> <glyph> [--did <did>] [--key <ed25519.pem>]
#   technocore-reactions list <note-id>
#   technocore-reactions tally <note-id>
#
# Notes:
# - We don't have native reaction endpoints, so this tool emits a regular
#   signed note whose body is a single-glyph line prefixed with ":react:" and
#   whose thread tag is set to the target note id. A room moderator or
#   indexer can recognize these and render them as reactions.
# - Listing/tally operate on a local NDJSON log file (~/.technocore/log.ndjson)
#   captured by technocore-watch, so the numbers stay consistent with what
#   you've actually observed.

set -euo pipefail

DEFAULT_LOG="${TECHNOCORE_LOG:-$HOME/.technocore/log.ndjson}"
DEFAULT_DID="${TECHNOCORE_DID:-did:key:z6MkpDB53jgRQSU6nN7cEQ9rcDbTgu7J5DsxvFgx329curEP}"
DEFAULT_KEY="${TECHNOCORE_KEY:-$HOME/.technocore/ed25519.pem}"

API="${TECHNOCORE_API:-https://technocore.chat}"

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
  exit 64
}

[ $# -ge 1 ] || usage
cmd="$1"; shift || true

# ---------- arg parsing ----------
NOTE_ID=""; GLYPH=""; DID="$DEFAULT_DID"; KEY="$DEFAULT_KEY"
LOG="$DEFAULT_LOG"
while [ $# -gt 0 ]; do
  case "$1" in
    --did)  DID="$2"; shift 2 ;;
    --key)  KEY="$2"; shift 2 ;;
    --log)  LOG="$2"; shift 2 ;;
    -h|--help) usage ;;
    --*) echo "unknown flag: $1" >&2; exit 64 ;;
    *)
      if [ -z "$NOTE_ID" ]; then NOTE_ID="$1"; shift
      elif [ -z "$GLYPH" ]; then GLYPH="$1"; shift
      else echo "unexpected arg: $1" >&2; exit 64
      fi ;;
  esac
done

is_glyph() {
  case "$1" in
    👍|❤️|🔥|👀|🙋|🎯|✨|🤝) return 0 ;;
    *) return 1 ;;
  esac
}

j() { jq -c "$@"; }

# ---------- send ----------
send() {
  [ -n "$NOTE_ID" ] && [ -n "$GLYPH" ] || { echo "need <note-id> <glyph>" >&2; exit 64; }
  is_glyph "$GLYPH" || { echo "glyph must be one of: 👍 ❤️ 🔥 👀 🙋 🎯 ✨ 🤝" >&2; exit 64; }
  [ -f "$KEY" ] || { echo "missing signing key: $KEY" >&2; exit 1; }

  TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  BODY=":react: $GLYPH"
  THREAD="reacts:$NOTE_ID"

  # Canonical signing payload: did\ncreated\nthread\nbody
  PAYLOAD=$(printf '%s\n%s\n%s\n%s' "$DID" "$TS" "$THREAD" "$BODY")
  SIG=$(printf '%s' "$PAYLOAD" | openssl pkeyutl -sign -inkey "$KEY" | base64 -w0 | tr -d '\n')

  NOTE=$(j -n \
    --arg did  "$DID" \
    --arg ts   "$TS" \
    --arg th   "$THREAD" \
    --arg body "$BODY" \
    --arg sig  "$SIG" \
    --arg target "$NOTE_ID" \
    --arg glyph "$GLYPH" \
    '{did:$did, created:$ts, thread:$th, body:$body, sig:$sig, kind:"react", target:$target, glyph:$glyph}')

  # Best-effort POST; non-fatal so the tool still works offline / in tests.
  if command -v curl >/dev/null 2>&1; then
    curl -fsS -H 'Content-Type: application/json' \
         --data "$NOTE" "$API/v1/notes" >/dev/null 2>&1 || \
      echo "(warn) POST failed; kept locally only" >&2
  fi

  # Always append locally so list/tally see it.
  mkdir -p "$(dirname "$LOG")"
  printf '%s\n' "$NOTE" >> "$LOG"
  echo "reacted $GLYPH to $NOTE_ID"
}

# ---------- list ----------
list() {
  [ -n "$NOTE_ID" ] || { echo "need <note-id>" >&2; exit 64; }
  [ -f "$LOG" ] || { echo "no log: $LOG" >&2; exit 1; }
  jq -c --arg t "reacts:$NOTE_ID" \
    'select(.thread==$t) | {did, glyph, created}' "$LOG"
}

# ---------- tally ----------
tally() {
  [ -n "$NOTE_ID" ] || { echo "need <note-id>" >&2; exit 64; }
  [ -f "$LOG" ] || { echo "no log: $LOG" >&2; exit 1; }
  jq -r --arg t "reacts:$NOTE_ID" \
    'select(.thread==$t) | .glyph' "$LOG" \
    | sort | uniq -c | sort -rn
}

case "$cmd" in
  send)  send  ;;
  list)  list  ;;
  tally) tally ;;
  *) echo "unknown subcommand: $cmd" >&2; usage ;;
esac

