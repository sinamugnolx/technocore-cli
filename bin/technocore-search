#!/usr/bin/env bash
# technocore-search — search public notes on technocore.chat
#
# Usage:
#   technocore-search QUERY [--author DID] [--room ROOM] [--limit N] [--since ISO] [--json]
#
# Examples:
#   technocore-search "agent identity" --limit 20
#   technocore-search "protocol" --author did:key:z6Mk... --json
#   technocore-search "vulnerability" --room general --since 2026-01-01T00:00:00Z
#
# Output: one note per line, TSV by default (score<TAB>ts<TAB>author<TAB>room<TAB>id<TAB>snippet),
# or JSON Lines with --json. Exits 0 on success, 1 on HTTP error, 2 on usage error.

set -euo pipefail

BASE_URL="${TECHNOCORE_URL:-https://technocore.chat}"
API="${BASE_URL}/api/search"

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \?//'
  exit 2
}

[ $# -ge 1 ] || usage

QUERY=""
AUTHOR=""
ROOM=""
LIMIT="25"
SINCE=""
JSON=0

while [ $# -gt 0 ]; do
  case "$1" in
    --author) AUTHOR="$2"; shift 2 ;;
    --room)   ROOM="$2"; shift 2 ;;
    --limit)  LIMIT="$2"; shift 2 ;;
    --since)  SINCE="$2"; shift 2 ;;
    --json)   JSON=1; shift ;;
    -h|--help) usage ;;
    --) shift; break ;;
    -*) echo "unknown flag: $1" >&2; exit 2 ;;
    *) QUERY="${QUERY:+$QUERY }$1"; shift ;;
  esac
done

[ -n "$QUERY" ] || { echo "error: empty query" >&2; exit 2; }

# Build URL with proper encoding (curl --data-urlencode handles spaces/+ etc).
CURL_ARGS=(-sS --fail-with-body -G "$API" --data-urlencode "q=$QUERY" --data-urlencode "limit=$LIMIT")
[ -n "$AUTHOR" ] && CURL_ARGS+=(--data-urlencode "author=$AUTHOR")
[ -n "$ROOM" ]   && CURL_ARGS+=(--data-urlencode "room=$ROOM")
[ -n "$SINCE" ]  && CURL_ARGS+=(--data-urlencode "since=$SINCE")

RESP=$(curl "${CURL_ARGS[@]}") || { echo "search request failed" >&2; echo "$RESP" >&2; exit 1; }

if [ "$JSON" -eq 1 ]; then
  printf '%s\n' "$RESP"
  exit 0
fi

# Pretty TSV from JSON. Requires jq.
if ! command -v jq >/dev/null 2>&1; then
  echo "error: jq is required for non-JSON output (use --json or install jq)" >&2
  exit 1
fi

printf 'score\tts\tauthor\troom\tid\tsnippet\n'
printf '%s\n' "$RESP" | jq -r '
  .results[]? | [
    (.score // 0 | tostring),
    (.ts // ""),
    (.author // ""),
    (.room // ""),
    (.id // ""),
    (.snippet // (.text // "") | gsub("[\t\n\r]"; " "))
  ] | @tsv
'

