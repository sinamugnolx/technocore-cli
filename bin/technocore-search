#!/usr/bin/env bash
# technocore-search — full-text search across archived technocore threads.
#
# Usage:
#   technocore-search QUERY [--room ROOM] [--author DID] [--since ISO] [--until ISO] [--limit N] [--context N] [--json]
#
# Reads .jsonl archives produced by `technocore-thread-archive` (one JSON object
# per line: {"room","id","author","ts","text","sig"}). By default it scans
# ~/.local/share/technocore/archive/*.jsonl, but you can point it elsewhere via
# TECHNOCORE_ARCHIVE_DIR. Exit code: 0 on any match, 1 on none, 2 on error.
#
# Examples:
#   technocore-search "key rotation" --limit 20
#   technocore-search "DID" --room agents --author did:key:z6Mk... --json
#   technocore-search "handshake" --since 2026-01-01T00:00:00Z --context 2
set -euo pipefail

print_help() {
  sed -n '2,12p' "$0" | sed 's/^# \?//'
}

err() { printf 'technocore-search: %s\n' "$*" >&2; }

need_jq() {
  command -v jq >/dev/null 2>&1 || { err "jq is required (https://jqlang.github.io/jq/)"; exit 2; }
}

if [[ $# -lt 1 ]]; then print_help >&2; exit 2; fi

QUERY=""
ROOM=""
AUTHOR=""
SINCE=""
UNTIL=""
LIMIT=50
CONTEXT=0
JSON_OUT=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) print_help; exit 0 ;;
    --room)    ROOM="$2"; shift 2 ;;
    --author)  AUTHOR="$2"; shift 2 ;;
    --since)   SINCE="$2"; shift 2 ;;
    --until)   UNTIL="$2"; shift 2 ;;
    --limit)   LIMIT="$2"; shift 2 ;;
    --context) CONTEXT="$2"; shift 2 ;;
    --json)    JSON_OUT=1; shift ;;
    --) shift; QUERY="${QUERY:-}${QUERY:+ }${*}"; break ;;
    -*) err "unknown flag: $1"; exit 2 ;;
    *)
      if [[ -z "$QUERY" ]]; then QUERY="$1"; else QUERY="$QUERY $1"; fi
      shift ;;
  esac
done

[[ -n "$QUERY" ]] || { err "missing QUERY"; exit 2; }
need_jq

ARCHIVE_DIR="${TECHNOCORE_ARCHIVE_DIR:-$HOME/.local/share/technocore/archive}"
[[ -d "$ARCHIVE_DIR" ]] || { err "archive dir not found: $ARCHIVE_DIR"; exit 2; }

shopt -s nullglob globstar
FILES=("$ARCHIVE_DIR"/*.jsonl)
${#FILES[@]} -gt 0 || { err "no .jsonl archives in $ARCHIVE_DIR"; exit 2; }

# jq filter — matches query as a case-insensitive substring in text.
# Date comparisons use lexicographic ordering on ISO-8601 (which is correct).
JQ_FILTER=$(cat <<'EOF'
  select(.text != null)
  | select(.text | test($q; "i"))
  | select($room == "" or .room == $room)
  | select($author == "" or .author == $author)
  | select($since == "" or .ts >= $since)
  | select($until == "" or .ts <= $until)
EOF
)

HITS=$(jq -c --arg q "$QUERY" \
             --arg room "$ROOM" \
             --arg author "$AUTHOR" \
             --arg since "$SINCE" \
             --arg until "$UNTIL" \
             "$JQ_FILTER" "${FILES[@]}" 2>/dev/null || true)

# Cap results to LIMIT (deterministic: order of files then arrival order).
HITS=$(printf '%s\n' "$HITS" | grep -v '^$' | head -n "$LIMIT")

if [[ -z "$HITS" ]]; then
  exit 1
fi

if [[ "$JSON_OUT" -eq 1 ]]; then
  printf '%s\n' "$HITS"
  exit 0
fi

# Pretty / context mode.
count=0
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  count=$((count+1))
  jq -r --argjson ctx "$CONTEXT" \
    '"
  \(.ts)  room=\(.room // "?")  id=\(.id // "?")
  author: \(.author // "?")
  \n  \(.text | gsub("\n"; "\\n  "))"' <<<"$line"
  if [[ "$CONTEXT" -gt 0 ]]; then
    printf '    (context=%d not supported in flat mode; use --json for raw)\n' "$CONTEXT" >&2
  fi
done <<<"$HITS"

printf '\n%d match(es) for query: %q\n' "$count" "$QUERY"
exit 0

