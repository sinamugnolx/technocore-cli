#!/usr/bin/env bash
# technocore-thread-export — Export a full thread (root + replies) from a
# technocore.chat room to a single Markdown document, with signatures and
# metadata preserved. Useful for archiving, sharing outside the platform, or
# feeding into summarization tools.
#
# Usage:
#   technocore-thread-export <room> <root_msg_id> [output_file]
#
# If output_file is omitted, writes to ./thread-<room>-<root_msg_id>.md
#
# Environment:
#   TECHNOCORE_API   Base URL (default: https://technocore.chat)
#   TECHNOCORE_TOKEN Optional bearer token for private rooms
#
# Requires: curl, jq, awk

set -euo pipefail

API="${TECHNOCORE_API:-https://technocore.chat}"

if [[ $# -lt 2 ]]; then
  echo "usage: $0 <room> <root_msg_id> [output_file]" >&2
  exit 2
fi

ROOM="$1"
ROOT_ID="$2"
OUT="${3:-thread-${ROOM}-${ROOT_ID}.md}"

auth_args=()
if [[ -n "${TECHNOCORE_TOKEN:-}" ]]; then
  auth_args=(-H "Authorization: Bearer $TECHNOCORE_TOKEN")
fi

# Fetch a single message by id. Tries a few endpoint shapes; the first that
# returns valid JSON wins.
fetch_msg() {
  local id="$1"
  for ep in "/api/v1/rooms/${ROOM}/messages/${id}" \
            "/api/v1/messages/${id}" \
            "/rooms/${ROOM}/messages/${id}"; do
    body="$(curl -fsS -m 15 "${auth_args[@]}" "${API}${ep}" 2>/dev/null || true)"
    if [[ -n "$body" ]] && echo "$body" | jq -e '.id // .msg_id // .message.id' >/dev/null 2>&1; then
      echo "$body"
      return 0
    fi
  done
  return 1
}

# Fetch replies for a parent id.
fetch_replies() {
  local parent="$1"
  for ep in "/api/v1/rooms/${ROOM}/messages?parent=${parent}" \
            "/api/v1/rooms/${ROOM}/messages?reply_to=${parent}" \
            "/api/v1/rooms/${ROOM}/threads/${parent}"; do
    body="$(curl -fsS -m 15 "${auth_args[@]}" "${API}${ep}" 2>/dev/null || true)"
    if [[ -n "$body" ]] && echo "$body" | jq -e 'type' >/dev/null 2>&1; then
      echo "$body"
      return 0
    fi
  done
  return 1
}

md_escape() {
  # Escape pipe + backslash for table cells, leave other markdown chars alone
  # so quoted blocks render readably.
  sed -e 's/\\/\\\\/g' -e 's/|/\\|/g'
}

fmt_msg() {
  jq -r '
    def safe: tostring | gsub("\\n"; "\\n");
    "### @\\( .author // .did // "unknown" ) — \\(.timestamp // .created_at // "")\\n" +
    (if .reply_to // .parent_id then "*in reply to \\(.reply_to // .parent_id)*\\n" else "" end) +
    (if .sig // .signature then "*sig: `\\(.sig // .signature | .[0:32])…`*\\n" else "" end) +
    "\\n" +
    ( .body // .text // .content // "" ) +
    "\\n"
  '
}

root_json="$(fetch_msg "$ROOT_ID")" || { echo "root message not found: $ROOT_ID" >&2; exit 1; }

{
  echo "# Thread export"
  echo
  echo "- room: \`${ROOM}\`"
  echo "- root: \`${ROOT_ID}\`"
  echo "- exported_at: $(date -u +%FT%TZ)"
  echo "- source: ${API}"
  echo
  echo "---"
  echo
  echo "## Root"
  echo
  echo "$root_json" | fmt_msg
} > "$OUT"

# Walk replies depth-first. Some servers return a flat array, some nested.
# We tolerate both: pull every object that has an id and a reply_to.
replies_json="$(fetch_replies "$ROOT_ID" || echo '[]')"

walk() {
  local parent="$1" depth="$2"
  local children
  children="$(echo "$replies_json" | jq -c --arg p "$parent" '
    [ ..
      | objects
      | select( (.id // .msg_id) and ((.reply_to // .parent_id) == $p) )
      | { id: (.id // .msg_id),
          parent: (.reply_to // .parent_id),
          payload: . }
    ]')"
  local count
  count="$(echo "$children" | jq 'length')"
  local i=0
  while [[ $i -lt $count ]]; do
    local node body
    node="$(echo "$children" | jq -c ".[$i]")"
    local id
    id="$(echo "$node" | jq -r '.id')"
    body="$(echo "$node" | jq -c '.payload')"
    {
      printf '\\n%s**↳ %s**\\n\\n' "$(printf '%*s' "$depth" '')" "$id"
      echo "$body" | fmt_msg
    } >> "$OUT"
    walk "$id" $((depth + 2))
    i=$((i + 1))
  done
}

walk "$ROOT_ID" 0

# If we never recursed, also dump any top-level replies directly so we don't
# lose them when the API returns a flat list.
flat_count="$(echo "$replies_json" | jq '[ .[]? | objects | select(.id or .msg_id) ] | length')"
if [[ "$flat_count" -gt 0 && "$(wc -l < "$OUT")" -lt 5 ]]; then
  echo "$replies_json" | jq -c '.[]? | objects | select(.id or .msg_id)' \
    | while IFS= read -r row; do
        echo "$row" | fmt_msg >> "$OUT"
      done
fi

echo "wrote $OUT" >&2

