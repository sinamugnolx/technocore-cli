#!/usr/bin/env bash
# technocore-thread-export — Export a full technocore thread to a single
# Markdown document for offline reading, archiving, or sharing.
#
# Usage:
#   technocore-thread-export <thread_root_id> [output_file]
#
# If output_file is omitted, the Markdown is written to stdout.
#
# The exporter walks the reply tree of a thread starting from the given
# root note id, fetches each note via the technocore HTTP API, and emits
# a clean, indented Markdown rendering with author DIDs, timestamps, and
# note bodies. It also writes a YAML front-matter block with thread
# metadata so the file is friendly to static-site generators.
#
# Configuration via environment:
#   TECHNOCORE_API   base URL of the technocore server
#                   (default: http://127.0.0.1:8080)
#   TECHNOCORE_TOKEN optional bearer token for authenticated reads
#
# Examples:
#   technocore-thread-export note:abc123 > thread.md
#   technocore-thread-export note:abc123 archive.md
#   TECHNOCORE_API=https://technocore.example.com \
#       technocore-thread-export note:abc123 thread.md

set -euo pipefail

API="${TECHNOCORE_API:-http://127.0.0.1:8080}"
TOKEN="${TECHNOCORE_TOKEN:-}"

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "usage: technocore-thread-export <thread_root_id> [output_file]" >&2
    exit 64
fi

ROOT_ID="$1"
OUT="${2:-/dev/stdout}"

# --- HTTP helper ------------------------------------------------------------
# fetch_note <id>  ->  prints JSON for the note on stdout, fails loudly on error.
fetch_note() {
    local id="$1"
    local url="${API}/v1/notes/${id}"
    local headers=(-H "Accept: application/json")
    if [[ -n "$TOKEN" ]]; then
        headers+=(-H "Authorization: Bearer ${TOKEN}")
    fi
    if ! curl -fsS --max-time 15 "${headers[@]}" "$url"; then
        echo "technocore-thread-export: failed to fetch $id" >&2
        return 1
    fi
}

# --- JSON helpers (no jq dependency) ----------------------------------------
# Extract a top-level string field from a single-line JSON object.
json_str() {
    # $1=json  $2=key
    printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\\([^"]*\\)\".*/\\1/p" | head -n1
}
# Extract a top-level array field, one element per line, stripping quotes.
json_arr() {
    # $1=json  $2=key  -> lines
    printf '%s' "$1" \
        | sed -n "/\"$2\"[[:space:]]*:[[:space:]]*\[/,/]/p" \
        | sed -n 's/^[[:space:]]*"\([^\\"]*\)".*/\1/p'
}

# Recursively render a note and its replies as indented Markdown.
# Args: $1=note_id  $2=depth
render_note() {
    local id="$1" depth="$2"
    local json
    json="$(fetch_note "$id")"

    local author ts body reply_to
    author="$(json_str "$json" author)"
    ts="$(json_str "$json" created_at)"
    body="$(json_str "$json" body)"
    reply_to="$(json_str "$json" reply_to)"

    local prefix
    prefix="$(printf '>%.0s' $(seq 1 $depth))"

    # Markdown blockquote per nesting level.
    {
        printf '%s **%s** — %s\n' "$prefix" "${author:-unknown}" "${ts:-?}"
        if [[ -n "$body" ]]; then
            # Indent every body line with the same quote prefix.
            printf '%s' "$body" \
                | sed "s|^|$prefix |; s|^$prefix $|$prefix|"
        fi
        printf '\n'
    }

    # Recurse into replies in deterministic order.
    local replies reply
    mapfile -t replies < <(json_arr "$json" replies | sort)
    for reply in "${replies[@]}"; do
        [[ -n "$reply" ]] || continue
        render_note "$reply" $((depth + 1))
    done
}

# --- Main --------------------------------------------------------------------
ROOT_JSON="$(fetch_note "$ROOT_ID")"

ROOT_AUTHOR="$(json_str "$ROOT_JSON" author)"
ROOT_TITLE="$(json_str "$ROOT_JSON" title)"
ROOT_TS="$(json_str "$ROOT_JSON" created_at)"
ROOT_BODY="$(json_str "$ROOT_JSON" body)"
ROOT_REPLIES_LINES="$(json_arr "$ROOT_JSON" replies | wc -l)"

{
    printf -- '---\n'
    printf 'thread_id: %s\n' "$ROOT_ID"
    printf 'author: %s\n'    "${ROOT_AUTHOR:-unknown}"
    printf 'created_at: %s\n' "${ROOT_TS:-unknown}"
    printf 'exported_at: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'api: %s\n' "$API"
    printf -- '---\n\n'

    printf '# Thread %s\n\n' "${ROOT_TITLE:-$ROOT_ID}"
    printf 'Original post by **%s** at %s.\n\n' \
        "${ROOT_AUTHOR:-unknown}" "${ROOT_TS:-?}"

    if [[ -n "$ROOT_BODY" ]]; then
        printf '%s\n\n' "$ROOT_BODY"
    fi

    printf '## Replies\n\n'

    mapfile -t ROOT_REPLIES < <(json_arr "$ROOT_JSON" replies | sort)
    if [[ ${#ROOT_REPLIES[@]} -eq 0 || -z "${ROOT_REPLIES[0]}" ]]; then
        printf '_No replies._\n'
    else
        for reply in "${ROOT_REPLIES[@]}"; do
            [[ -n "$reply" ]] || continue
            render_note "$reply" 1
        done
    fi
} > "$OUT"

echo "technocore-thread-export: wrote $OUT (root replies: $ROOT_REPLIES_LINES)" >&2

