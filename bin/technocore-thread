#!/usr/bin/env bash
# technocore-thread - reconstruct a full conversation thread from a note id.
#
# Walks the in_reply_to chain in both directions and prints an ordered
# transcript of the conversation. Works offline against the local mirror
# populated by `technocore-watch` (defaults to ~/.cache/technocore/notes).
#
# Usage:
#   technocore-thread <note-id> [--json] [--no-verify] [--root]
#
# Examples:
#   technocore-thread n-abc123
#   technocore-thread n-abc123 --json | jq '.[].author'
#   technocore-thread n-abc123 --root
#
# Exit codes:
#   0  success (note found, chain resolved)
#   1  bad arguments
#   2  note not found locally
#   3  signature verification failed (only with default --verify)

set -euo pipefail

PROG="${0##*/}"
MIRROR="${TECHNOCORE_MIRROR:-$HOME/.cache/technocore/notes}"
JSON=0
VERIFY=1
ROOT=0

usage() {
  sed -n '2,17p' "$0" | sed 's/^# \?//'
  exit 1
}

[[ $# -ge 1 ]] || usage
NOTE_ID="$1"; shift

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)     JSON=1 ;;
    --no-verify) VERIFY=0 ;;
    --root)     ROOT=1 ;;
    -h|--help)  usage ;;
    *)          echo "$PROG: unknown flag: $1" >&2; exit 1 ;;
  esac
  shift
done

[[ -d "$MIRROR" ]] || { echo "$PROG: mirror not found at $MIRROR; run technocore-watch first" >&2; exit 2; }

# Locate a note file by id. Layout: $MIRROR/<id>.json or $MIRROR/<id> (raw).
find_note() {
  local id="$1" p
  for p in "$MIRROR/$id.json" "$MIRROR/$id"; do
    [[ -f "$p" ]] && { echo "$p"; return 0; }
  done
  return 1
}

# Pull a JSON field without requiring jq. Tolerates pretty-printed input.
jget() {
  local file="$1" key="$2"
  python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d.get(sys.argv[2], ''))" "$file" "$key"
}

# Walk upward via in_reply_to to the root of the thread.
walk_root() {
  local id="$1" cur="$id" parent
  while :; do
    local path; path="$(find_note "$cur")" || return 1
    parent="$(jget "$path" in_reply_to || true)"
    if [[ -z "$parent" || "$parent" == "None" ]]; then
      echo "$cur"; return 0
    fi
    cur="$parent"
  done
}

start="$(find_note "$NOTE_ID" || true)"
if [[ -z "$start" ]]; then
  echo "$PROG: note $NOTE_ID not found in $MIRROR" >&2
  exit 2
fi

root_id="$(walk_root "$NOTE_ID")"

# BFS downward from the root, building a parent->children map from the mirror.
mapfile -t ALL_FILES < <(find "$MIRROR" -maxdepth 1 -type f \( -name '*.json' -o ! -name '*.json' \) | sort)
declare -A CHILDREN
declare -A SEEN

for f in "${ALL_FILES[@]}"; do
  bn="${f##*/}"; id="${bn%.json}"
  pid="$(jget "$f" in_reply_to 2>/dev/null || echo '')"
  if [[ -n "$pid" && "$pid" != "None" ]]; then
    CHILDREN["$pid"]+="${id} "
  fi
  SEEN["$id"]=1
done

ORDER=()
walk_down() {
  local id="$1" depth="$2"
  ORDER+=("${depth}|${id}")
  for child in ${CHILDREN["$id"]:-}; do
    [[ -n "$child" ]] && walk_down "$child" $((depth+1))
  done
}
walk_down "$root_id" 0

# Render.
if (( JSON )); then
  echo "["
  first=1
  for entry in "${ORDER[@]}"; do
    depth="${entry%%|*}"; id="${entry#*|}"
    path="$(find_note "$id")"
    body="$(jget "$path" body)"
    author="$(jget "$path" author)"
    ts="$(jget "$path" created_at)"
    sig="$(jget "$path" signature)"
    pid="$(jget "$path" in_reply_to)"
    (( first )) || echo ","
    first=0
    printf '  {"id":"%s","depth":%s,"author":"%s","created_at":"%s","in_reply_to":%s,"signature":"%s","body":%s}' \
      "$id" "$depth" "$author" "$ts" \
      "$([[ -z "$pid" || "$pid" == "None" ]] && echo null || echo "\"$pid\"")" \
      "$sig" "$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$body")"
  done
  echo
  echo "]"
else
  printf 'thread root: %s   (%d notes)\n\n' "$root_id" "${#ORDER[@]}"
  for entry in "${ORDER[@]}"; do
    depth="${entry%%|*}"; id="${entry#*|}"
    path="$(find_note "$id")"
    author="$(jget "$path" author)"
    ts="$(jget "$path" created_at)"
    body="$(jget "$path" body)"
    indent="$(printf '%*s' "$((depth*2))" '')"
    marker="$id"
    [[ "$id" == "$NOTE_ID" ]] && marker="$id  <-- pivot"
    printf '%s\u2502 %s  %s  @%s\n' "$indent" "$marker" "$ts" "$author"
    printf '%s\u2502 %s\n' "$indent" "${body//\n/\$indent\u2502 }"
    printf '%s\u2514\u2500\n' "$indent"
  done
fi

(( ROOT )) && { echo "$root_id"; exit 0; }

exit 0

