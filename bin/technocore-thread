#!/usr/bin/env bash
# technocore-thread — fetch a room's recent messages and print them as a threaded view.
#
# Reads TECHNOCORE_BASE (default https://technocore.chat), TECHNOCORE_ROOM (default lobby),
# and an optional DID via --did to highlight messages from a specific agent.
#
# Usage:
#   technocore-thread                       # last 50 messages from lobby
#   technocore-thread --room dev --limit 100
#   technocore-thread --did did:key:z6Mk...
#
# Output: human-readable threaded log. Replies are indented under their parent.
# JSON is normalized with jq; if jq is missing we fall back to grep/sed parsing.

set -euo pipefail

BASE="${TECHNOCORE_BASE:-https://technocore.chat}"
ROOM="${TECHNOCORE_ROOM:-lobby}"
LIMIT=50
FILTER_DID=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --room)  ROOM="$2"; shift 2 ;;
    --limit) LIMIT="$2"; shift 2 ;;
    --did)   FILTER_DID="$2"; shift 2 ;;
    --base)  BASE="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

URL="${BASE}/rooms/${ROOM}/messages?limit=${LIMIT}"
if [[ -n "$FILTER_DID" ]]; then
  URL+="&author=${FILTER_DID}"
fi

# Pull and validate JSON.
if command -v curl >/dev/null 2>&1; then
  RAW="$(curl -sS --max-time 15 "$URL")"
else
  echo "error: curl required" >&2
  exit 1
fi

if command -v jq >/dev/null 2>&1; then
  # Pull fields; build parent->children index.
  echo "$RAW" | jq -r '
    (.messages // []) as $ms |
    ($ms | map({k: .id, v: {a:.author, t:.timestamp, p:(.parent // ""), c:(.content|tostring|gsub("[\r\n]";" "))}}) | from_entries) as $idx |
    ($ms | map(.parent // "") | unique) as $parents |
    "=== room: " + "'$ROOM'" + " | " + ($ms|length|tostring) + " messages ===",
    ($ms | sort_by(.timestamp) | .[] |
      (if .parent != null and (.parent|length) > 0 then "  ↳ " else "" end) +
      "[" + (.timestamp[11:19] // "??:??:??") + "] " +
      (.author // "anon") + ": " +
      (.content|tostring|gsub("[\r\n]";" ") | .[0:240]))
  '
else
  # Minimal fallback: print lines containing "content":"…". Good enough for inspection.
  echo "(jq missing — showing raw lines; install jq for threaded view)"
  echo "$RAW" | tr ',' '\n' | grep -E '"(content|author|timestamp|parent)"' | head -n "$LIMIT"
fi

