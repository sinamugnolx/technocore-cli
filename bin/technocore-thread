#!/usr/bin/env bash
# technocore-thread — reconstruct a conversation thread from root to leaf.
#
# Reads a JSONL stream (stdin or --file) of technocore notes and prints the
# chain of replies that descend from a given root note id, ordered from root
# to the deepest leaf. Useful for following a discussion that branched.
#
# Usage:
#   technocore-thread --root <id> [--file notes.jsonl]
#   cat notes.jsonl | technocore-thread --root <id>
#
# Notes are expected to be JSON objects containing at minimum:
#   id           — note id
#   reply_to     — parent note id (optional; absent on root)
#   author       — did:key string
#   body         — message body
#   created_at   — ISO8601 timestamp (optional, used for sorting siblings)
#
# Output: one JSON object per line, root first, then each child indented by
# depth, terminated by a summary line {"summary":{...}}.

set -euo pipefail

print_help() {
  sed -n '2,20p' "$0" | sed 's/^# //; s/^#//'
  exit 0
}

ROOT=""
FILE=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) print_help ;;
    --root) ROOT="$2"; shift 2 ;;
    --file) FILE="$2"; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$ROOT" ]; then
  echo "--root <id> is required" >&2
  exit 2
fi

if [ -n "$FILE" ]; then
  exec < "$FILE"
fi

# Pass 1: load all notes into a temp file, build parent->children index in memory.
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

cat > "$TMP"

# Build two awk tables: by-id lookup and children adjacency.
# awk script reads JSONL line-by-line. It extracts "id" and "reply_to" using
# a small regex (good enough for well-formed JSON; avoids requiring jq).

ROOT_FOUND=0
ROOT_NOTE=""
LEAF_COUNT=0
MAX_DEPTH=0

# Use python3 if available for robust JSON; fall back to awk+sed.
if command -v python3 >/dev/null 2>&1; then
  eval "$(python3 - "$ROOT" "$TMP" <<'PY'
import json, sys
root = sys.argv[1]
path = sys.argv[2]
notes = {}
children = {}
order_by_parent = {}
with open(path) as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            n = json.loads(line)
        except Exception:
            continue
        nid = n.get("id")
        if not nid:
            continue
        notes[nid] = n
        parent = n.get("reply_to")
        if parent is None:
            parent = ""
        children.setdefault(parent, []).append(nid)
        order_by_parent.setdefault(parent, []).append((
            n.get("created_at", ""), nid
        ))
for parent, lst in order_by_parent.items():
    lst.sort(key=lambda x: (x[0], x[1]))
    children[parent] = [nid for _, nid in lst]

import pprint, json as J2
def esc(v):
    return v.replace("'", "'\\''")
print("CHILDREN=" + J2.dumps(children).replace("'\\''", "'\\''"))
print("NOTES=" + J2.dumps({k: notes[k] for k in notes}).replace("'\\''", "'\\''"))
PY
)"

  if [ -z "${NOTES:-}" ]; then
    echo "no parseable notes in stream" >&2
    exit 1
  fi

  # Check root exists.
  if ! python3 -c "import json,sys; d=json.loads(sys.argv[1]); sys.exit(0 if sys.argv[2] in d else 1)" "$NOTES" "$ROOT" 2>/dev/null; then
    echo "root note $ROOT not found in stream" >&2
    exit 1
  fi

  # Walk the tree, emitting each node with its depth.
  walk() {
    local parent="$1"
    local depth="$2"
    local kids
    kids=$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); p=sys.argv[2]; print(' '.join(d.get(p, [])))" "$CHILDREN" "$parent")
    for cid in $kids; do
      local note
      note=$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(json.dumps(d[sys.argv[2]], separators=(',',':')))" "$NOTES" "$cid")
      # Emit with a depth prefix using a sibling field.
      python3 -c "import json,sys; n=json.loads(sys.argv[1]); n['depth']=int(sys.argv[2]); print(json.dumps(n, separators=(',',':')))" "$note" "$depth"
      walk "$cid" "$((depth+1))"
    done
  }

  ROOT_NOTE=$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(json.dumps(d[sys.argv[2]], separators=(',',':')))" "$NOTES" "$ROOT")
  python3 -c "import json,sys; n=json.loads(sys.argv[1]); n['depth']=0; print(json.dumps(n, separators=(',',':')))" "$ROOT_NOTE"
  walk "$ROOT" 1

  LEAF_COUNT=$(python3 -c "
import json
d = json.loads('''$CHILDREN''')
root_kids = d.get('$ROOT', [])
def count(kid, kids_map):
    sub = kids_map.get(kid, [])
    if not sub:
        return 1
    return sum(count(s, kids_map) for s in sub)
print(sum(count(k, d) for k in root_kids))
")

  MAX_DEPTH=$(python3 -c "
import json
d = json.loads('''$CHILDREN''')
def depth(node, kids_map, d_now):
    sub = kids_map.get(node, [])
    if not sub:
        return d_now
    return max(depth(s, kids_map, d_now+1) for s in sub)
print(depth('$ROOT', d, 0))
")

  echo "{\"summary\":{\"root\":\"$ROOT\",\"leaf_count\":$LEAF_COUNT,\"max_depth\":$MAX_DEPTH}}"
else
  # Pure-shell fallback using awk + sed for JSON extraction. Less robust but
  # works on minimal busybox environments.
  echo "python3 not found; this tool requires python3 for safe JSON parsing" >&2
  exit 3
fi

