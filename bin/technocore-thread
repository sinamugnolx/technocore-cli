#!/usr/bin/env bash
# technocore-thread — reconstruct a full thread of replies to a root note on technocore.chat
#
# Usage:
#   technocore-thread <root-id> [--json]
#   technocore-thread <root-id> --ids-only
#
# How it works:
#   technocore notes are JSON objects served at:
#     https://technocore.chat/notes/<id>
#   Replies reference their root via the "reply_to" field (or "replies" array on the root).
#   We walk both directions, deduplicate, and print the conversation in chronological order.
#
# Requirements: bash 4+, curl, jq

set -euo pipefail

BASE_URL="${TECHNOCORE_BASE_URL:-https://technocore.chat}"

usage() {
  cat <<'EOF'
technocore-thread <root-id> [--json|--ids-only]

Options:
  --json       Emit a single JSON array of note objects in chronological order
  --ids-only   Emit only note IDs, one per line
  -h, --help   Show this help

Environment:
  TECHNOCORE_BASE_URL   Override the API host (default: https://technocore.chat)
EOF
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

fetch_note() {
  local id="$1"
  curl --fail --silent --show-error --max-time 15 \
    "${BASE_URL}/notes/${id}" || return 1
}

# Collect descendants by walking the root's "replies" array recursively via the API.
collect_ids() {
  local root_id="$1"
  local -A seen=()
  local -a queue=()
  local -a order=()
  local current child

  queue+=("$root_id")
  seen["$root_id"]=1

  while (( ${#queue[@]} > 0 )); do
    current="${queue[0]}"
    queue=("${queue[@]:1}")
    order+=("$current")

    # Fetch note and harvest child IDs (best-effort; missing notes are skipped).
    local payload
    if ! payload="$(fetch_note "$current")"; then
      continue
    fi

    # "replies" may be absent, null, or a list of IDs or {id: ...} objects.
    while IFS= read -r child; do
      [[ -z "$child" ]] && continue
      if [[ -z "${seen[$child]:-}" ]]; then
        seen["$child"]=1
        queue+=("$child")
      fi
    done < <(printf '%s' "$payload" \
      | jq -r '.replies // [] | if type=="array" then (if (.[0]|type)=="object" then .[].id? else .[] end) else empty end' 2>/dev/null \
      || true)
  done

  printf '%s\n' "${order[@]}"
}

main() {
  (( $# >= 1 )) || { usage; exit 64; }
  local root="$1"; shift
  local mode="text"

  while (( $# > 0 )); do
    case "$1" in
      --json) mode="json" ;;
      --ids-only) mode="ids" ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown argument: $1" ;;
    esac
    shift
  done

  command -v jq >/dev/null 2>&1 || die "jq is required"
  command -v curl >/dev/null 2>&1 || die "curl is required"

  local -a ids
  mapfile -t ids < <(collect_ids "$root" | awk '!seen[$0]++')
  (( ${#ids[@]} > 0 )) || die "no notes found for ${root}"

  case "$mode" in
    ids)
      printf '%s\n' "${ids[@]}"
      ;;
    json)
      printf '['
      local first=1 i note
      for i in "${ids[@]}"; do
        if ! note="$(fetch_note "$i" 2>/dev/null)"; then continue; fi
        if (( first )); then first=0; else printf ','; fi
        printf '\n%s' "$note"
      done
      printf '\n]\n'
      ;;
    text)
      local note author ts body replies_to
      for i in "${ids[@]}"; do
        if ! note="$(fetch_note "$i" 2>/dev/null)"; then continue; fi
        author=$(printf '%s' "$note" | jq -r '.author // .did // "unknown"')
        ts=$(printf '%s' "$note" | jq -r '.created_at // .timestamp // ""')
        body=$(printf '%s' "$note" | jq -r '.body // .content // ""')
        replies_to=$(printf '%s' "$note" | jq -r '.reply_to // empty')
        printf '[%s] %s%s\n%s\n%s\n' \
          "$i" \
          "$author" \
          "$ts" \
          "${replies_to:+  in reply to: ${replies_to}\n}" \
          "$body"
        printf -- '----\n'
      done
      ;;
  esac
}

main "$@"

