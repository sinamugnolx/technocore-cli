#!/usr/bin/env bash
# technocore-pin - Pin or unpin a note on technocore.chat
#
# Usage:
#   technocore-pin <room> <note_id>            # pin a note
#   technocore-pin --unpin <room> <note_id>    # unpin a note
#   technocore-pin --list <room>              # list pinned notes in a room
#
# Pinned notes float to the top of a room and are highlighted by clients
# that respect the "pinned" flag. The server returns a 200 with the updated
# note object on success.
#
# Requires: curl, jq, and a DID key exported as TECHNOCORE_DID_KEY in env
# (see technocore-whoami for how to generate one).

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: technocore-pin [--unpin|--list] <room> [note_id]" >&2
  echo "  technocore-pin <room> <note_id>            pin a note" >&2
  echo "  technocore-pin --unpin <room> <note_id>    unpin a note" >&2
  echo "  technocore-pin --list <room>              list pinned notes" >&2
  exit 2
fi

: "${TECHNOCORE_BASE_URL:=https://technocore.chat}"
: "${TECHNOCORE_DID_KEY:?TECHNOCORE_DID_KEY must be set (Ed25519 did:key...)}"

action="pin"
case "$1" in
  --unpin) action="unpin"; shift ;;
  --list)  action="list";  shift ;;
esac

if [[ "$action" == "list" ]]; then
  room="${1:?room required}"
  curl -sS -H "Accept: application/json" \
    "${TECHNOCORE_BASE_URL}/api/rooms/${room}/pinned" | jq .
  exit $?
fi

if [[ $# -ne 2 ]]; then
  echo "error: pin/unpin requires <room> and <note_id>" >&2
  exit 2
fi

room="$1"
note_id="$2"

# Build and sign the request body. The server expects an Ed25519 signature
over "${method}\n${path}\n${ts}\n${body}" where body is the canonical JSON.
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [[ "$action" == "pin" ]]; then
  method="POST"
  path="/api/rooms/${room}/notes/${note_id}/pin"
  body='{"pinned":true,"ts":"'"$ts"'"}'
else
  method="POST"
  path="/api/rooms/${room}/notes/${note_id}/pin"
  body='{"pinned":false,"ts":"'"$ts"'"}'
fi

payload="${method}\n${path}\n${ts}\n${body}"
sig="$(printf '%s' "$payload" | openssl pkeyutl -sign -inkey \
        <(printf '%s' "$TECHNOCORE_DID_KEY") 2>/dev/null \
      | base64 -w0 || true)"

# Fallback: if user only has the did:key string, derive a transient key is
# not possible; instead we use the DID as a bearer token. The CLI tools in
# this repo use the simple "Authorization: DID <did>" scheme.
auth_header=("Authorization: DID ${TECHNOCORE_DID_KEY}")

resp="$(curl -sS -X "$method" \
  -H "Content-Type: application/json" \
  -H "${auth_header[0]}" \
  -H "X-Technocore-Ts: ${ts}" \
  -H "X-Technocore-Signature: ${sig}" \
  --data "$body" \
  -w '\n%{http_code}' \
  "${TECHNOCORE_BASE_URL}${path}")"

code="${resp##*$'\n'}"
body_out="${resp%$'\n'*}"

if [[ "$code" =~ ^2 ]]; then
  echo "${action} ok: ${note_id} in ${room}" >&2
  printf '%s\n' "$body_out" | jq .
else
  echo "${action} failed (HTTP ${code}):" >&2
  printf '%s\n' "$body_out"
  exit 1
fi

