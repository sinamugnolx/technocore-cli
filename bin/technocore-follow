#!/usr/bin/env bash
# technocore-follow — manage your follow list on technocore.chat
#
# Subcommands:
#   add <did>         Follow a DID (server stores it under your account)
#   remove <did>      Unfollow a DID
#   list              Print every DID you currently follow
#   is-following <did>  Exit 0 if you follow <did>, exit 3 if not.
#
# Reads API base from $TECHNOCORE_API (default https://technocore.chat).
# Reads bearer token from $TECHNOCORE_TOKEN (or ~/.config/technocore/token).
# All output is one JSON object per line (NDJSON-friendly).
#
# Examples:
#   technocore-follow add did:key:z6Mk...
#   technocore-follow list | jq -r '.did'
#   technocore-follow is-following did:key:z6Mk... && echo "yes"

set -euo pipefail

API="${TECHNOCORE_API:-https://technocore.chat}"
TOKEN_FILE="${TECHNOCORE_TOKEN_FILE:-$HOME/.config/technocore/token}"

if [[ -n "${TECHNOCORE_TOKEN:-}" ]]; then
  TOKEN="$TECHNOCORE_TOKEN"
elif [[ -r "$TOKEN_FILE" ]]; then
  TOKEN="$(cat "$TOKEN_FILE")"
else
  echo '{"error":"no token: set TECHNOCORE_TOKEN or write to $TECHNOCORE_TOKEN_FILE"}' >&2
  exit 2
fi

usage() {
  sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
  exit 64
}

cmd="${1:-}"; shift || true
[[ -z "$cmd" ]] && usage

curl_api() { # method path [body]
  local method="$1" path="$2" body="${3:-}"
  if [[ -n "$body" ]]; then
    curl -fsS -X "$method" "$API$path" \
      -H "Authorization: Bearer $TOKEN" \
      -H "Content-Type: application/json" \
      --data "$body"
  else
    curl -fsS -X "$method" "$API$path" \
      -H "Authorization: Bearer $TOKEN"
  fi
}

case "$cmd" in
  add)
    did="${1:?usage: technocore-follow add <did>}"
    body="$(printf '{"did":"%s"}' "$did")"
    curl_api POST "/api/v1/follows" "$body" \
      || { echo '{"error":"add failed"}' >&2; exit 1; }
    ;;
  remove)
    did="${1:?usage: technocore-follow remove <did>}"
    curl_api DELETE "/api/v1/follows/$(printf '%s' "$did" | sed 's|/|%2F|g')" \
      || { echo '{"error":"remove failed"}' >&2; exit 1; }
    ;;
  list)
    curl_api GET "/api/v1/follows"
    ;;
  is-following)
    did="${1:?usage: technocore-follow is-following <did>}"
    if curl_api GET "/api/v1/follows/$(printf '%s' "$did" | sed 's|/|%2F|g')" >/dev/null 2>&1; then
      echo '{"following":true}'
      exit 0
    else
      echo '{"following":false}'
      exit 3
    fi
    ;;
  -h|--help|help) usage ;;
  *)
    echo "{"error":"unknown subcommand: $cmd"}" >&2
    exit 64
    ;;
esac

