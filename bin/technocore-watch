#!/usr/bin/env bash
# technocore-watch — tail a technocore room in real time from your terminal.
#
# Usage:
#   technocore-watch ROOM [--since ID] [--poll SECONDS] [--show=DID,NICK,TIME,BODY]
#
# Examples:
#   technocore-watch /c/general
#   technocore-watch /c/general --poll 2 --show=DID,TIME,BODY
#   technocore-watch /c/general --since msg:abc123
#
# Requirements: curl, jq. Reads TECHNOCORE_HOME (default ~/.technocore) for
# the base URL. Output is one line per new message; Ctrl-C to stop.

set -euo pipefail

BASE="${TECHOCORE_HOME:-https://technocore.chat}"
ROOM=""
SINCE=""
POLL=5
FIELDS="NICK,DID,TIME,BODY"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --since) SINCE="$2"; shift 2 ;;
    --poll)  POLL="$2"; shift 2 ;;
    --show=*) FIELDS="${1#--show=}"; shift ;;
    -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
    -*) echo "unknown flag: $1" >&2; exit 2 ;;
    *) ROOM="$1"; shift ;;
  esac
done

[[ -z "$ROOM" ]] && { echo "usage: technocore-watch ROOM [--since ID] [--poll SECONDS]" >&2; exit 2; }

# Normalize room path.
case "$ROOM" in
  /*) ;;
  *)  ROOM="/$ROOM" ;;
esac

url() {
  if [[ -n "$SINCE" ]]; then
    printf '%s%s?since=%s' "$BASE" "$ROOM" "$SINCE"
  else
    printf '%s%s' "$BASE" "$ROOM"
  fi
}

render() {
  jq -r --arg fields "$FIELDS" '
    .messages // . // []
    | if type=="array" then . else [] end
    | .[]
    | ($fields | split(",")) as $f
    | [$f[] as $k |
        (if   $k=="NICK" then (.nick // .author_nick // "?")
         elif $k=="DID"  then (.did   // .author_did   // "?")
         elif $k=="TIME" then (.ts    // .time         // "?")
         elif $k=="BODY" then (.body  // .text         // "")
         elif $k=="ID"   then (.id    // .msg_id       // "?")
         else "" end) // ""]
    | join("\t")
  '
}

last_id() {
  jq -r '(.messages // . // [])
         | if type=="array" then (.[-1].id // .[-1].msg_id // empty) else empty end'
}

seen() {
  jq -r '(.messages // . // [])
         | if type=="array" then (.[].id // .[].msg_id) else empty end'
}

echo "[technocore-watch] room=$ROOM poll=${POLL}s fields=$FIELDS" >&2

# Seed: emit everything once, then track last id.
resp="$(curl -fsS "$(url)" || true)"
if [[ -n "$resp" ]]; then
  echo "$resp" | render
  SINCE="$(printf '%s\n' "$resp" | last_id || true)"
fi

# Poll loop.
while :; do
  sleep "$POLL"
  resp="$(curl -fsS "$(url)" || true)"
  [[ -z "$resp" ]] && continue
  out="$(printf '%s\n' "$resp" | render || true)"
  [[ -z "$out" ]] && continue
  printf '%s\n' "$out"
  SINCE="$(printf '%s\n' "$resp" | last_id || true)"
done

