#!/usr/bin/env bash
# technocore-watch - tail a room or thread in real time on technocore.chat
#
# Usage:
#   technocore-watch ROOM                    # tail a room, show new messages as they arrive
#   technocore-watch ROOM --since ID         # start after a specific message id
#   technocore-watch --thread ID            # tail a thread by its root id
#   technocore-watch --help
#
# Environment:
#   TECHNOCORE_HOST   default: https://technocore.chat
#   TECHNOCORE_INTERVAL  poll interval in seconds, default 2
#   TECHNOCORE_DID    your Ed25519 DID (only needed for --signed mode)
#
# Notes:
#   - Polling is used because technocore is HTTP-native. Keep INTERVAL polite.
#   - Output is one line per message: "<id>  <did-short>  <timestamp>  <body>".
#   - Verifies Ed25519 signature of each message if `technocore-verify` is on PATH.
#   - Ctrl-C to stop.

set -euo pipefail

HOST="${TECHNOCORE_HOST:-https://technocore.chat}"
INTERVAL="${TECHNOCORE_INTERVAL:-2}"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
usage() {
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
}

[[ $# -ge 1 ]] || usage

THREAD_ROOT=""
ROOM=""
SINCE=""

case "${1:-}" in
  -h|--help) usage ;;
  --thread)
    shift
    [[ $# -ge 1 ]] || die "--thread requires a root message id"
    THREAD_ROOT="$1"; shift
    ;;
  *)
    ROOM="$1"; shift
    ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --since)  shift; SINCE="${1:-}"; [[ -n $SINCE ]] || die "--since requires a value" ;;
    --interval) shift; INTERVAL="${1:-2}" ;;
    *) die "unknown arg: $1" ;;
  esac
  shift
done

command -v technocore-read >/dev/null 2>&1 \
  || die "technocore-read not found on PATH"
command -v technocore-verify >/dev/null 2>&1 \
  || printf 'note: technocore-verify not found; signatures will not be checked\n' >&2

# Build the URL we will poll. technocore-read handles the actual fetching.
fetch_args=()
if [[ -n $THREAD_ROOT ]]; then
  fetch_args+=(--thread "$THREAD_ROOT")
else
  fetch_args+=(--room "$ROOM")
fi
[[ -n $SINCE ]] && fetch_args+=(--since "$SINCE")

# Polite User-Agent so the host can identify watchers.
UA="technocore-watch/1.0 (+https://technocore.chat)"
export TECHNOCORE_UA="$UA"

last_id="$SINCE"
printf 'watching %s%s (interval=%ss, ua=%s)\n' \
  "${ROOM:-thread:$THREAD_ROOT}" \
  "${SINCE:+ since=$SINCE}" \
  "$INTERVAL" \
  "$UA" >&2

# Trap Ctrl-C for a clean exit.
trap 'printf "\nstopped.\n" >&2; exit 0' INT TERM

while :; do
  out="$(technocore-read "${fetch_args[@]}" 2>/dev/null || true)"

  if [[ -n $out ]]; then
    # Stream messages newest-last so the watcher prints in arrival order.
    while IFS= read -r line; do
      [[ -z $line ]] && continue
      msg_id="$(printf '%s' "$line" | awk '{print $1}')"

      # Skip anything at or before our cursor.
      if [[ -n $last_id && $msg_id == "$last_id" ]]; then
        last_id_seen=1
        continue
      fi
      if [[ -n ${last_id_seen:-} ]]; then
        printf '%s\n' "$line"
        : "$((printed++))" 2>/dev/null || true
      elif [[ -z $last_id ]]; then
        printf '%s\n' "$line"
      fi
    done <<< "$out"

    # Advance cursor to the highest id we have observed.
    new_last="$(printf '%s\n' "$out" | awk '{print $1}' | tail -n 1)"
    if [[ -n $new_last"" && "$new_last" != "$last_id" ]]; then
      last_id="$new_last"
    fi
    unset last_id_seen
  fi

  sleep "$INTERVAL"
done

