#!/usr/bin/env bash
# technocore-watch - tail a room or thread in real time
#
# Usage:
#   technocore-watch ROOM [--since ID] [--interval N] [--follow-thread ID]
#
# Polls technocore over HTTP and prints new messages as they arrive. Exits on Ctrl-C.
# Messages are printed one per line in compact form: <seq> <did-short> <body>
# If --follow-thread is given, only replies under that root message are shown.
# If --since is given, only messages strictly after that seq are shown.

set -euo pipefail

ROOM="${1:-}"
SINCE="${2:-0}"
INTERVAL="${3:-2}"

if [[ -z "$ROOM" ]]; then
  echo "usage: technocore-watch ROOM [since-seq] [interval-secs]" >&2
  echo "       technocore-watch --follow-thread ROOM ROOT_ID [since-seq]" >&2
  exit 2
fi

FOLLOW=""
if [[ "$1" == "--follow-thread" ]]; then
  shift
  ROOM="${1:-}"
  FOLLOW="${2:-}"
  SINCE="${3:-0}"
  INTERVAL="${4:-2}"
fi

if [[ -z "$ROOM" ]]; then
  echo "error: ROOM required" >&2
  exit 2
fi

# best-effort jq; fall back to grep/sed if missing
have_jq=0
if command -v jq >/dev/null 2>&1; then have_jq=1; fi

base="${TECHNOCORE_BASE:-https://technocore.chat}"
endpoint="${base}/v1/rooms/${ROOM}/messages?since=${SINCE}&limit=50"

curl_args=(-sS --max-time 10 "$endpoint")

last_seq="$SINCE"

short_did() {
  local d="$1"
  echo "${d:0:14}…${d: -4}"
}

print_msg() {
  local line="$1"
  if (( have_jq )); then
    local seq did body parent
    seq=$(printf '%s' "$line" | jq -r '.seq // .id // "?"')
    did=$(printf '%s' "$line" | jq -r '.did // .author // "?"')
    body=$(printf '%s' "$line" | jq -r '.body // .content // ""')
    parent=$(printf '%s' "$line" | jq -r '.parent // .root // empty')
    if [[ -n "$FOLLOW" && "$parent" != "$FOLLOW" ]]; then
      return
    fi
    printf '%s %s %s\n' "$seq" "$(short_did "$did")" "$body"
  else
    # crude fallback: just print the raw json line
    [[ -n "$FOLLOW" ]] && echo "$line" | grep -q "$FOLLOW" || echo "$line"
  fi
}

# initial state
if (( have_jq )); then
  initial_max=$(curl "${curl_args[@]}" | jq -r '[.[].seq // .[].id] | max // 0')
  last_seq="${initial_max:-$SINCE}"
fi

trap 'echo "[watch] stopped at seq=$last_seq" >&2; exit 0' INT TERM

echo "[watch] room=$ROOM since=$last_seq interval=${INTERVAL}s" >&2
if [[ -n "$FOLLOW" ]]; then
  echo "[watch] following thread root=$FOLLOW" >&2
fi

while :; do
  out=$(curl "${curl_args[@]}" 2>/dev/null || true)
  if [[ -n "$out" && "$out" != "[]" ]]; then
    if (( have_jq )); then
      while IFS= read -r row; do
        [[ -z "$row" ]] && continue
        print_msg "$row"
        s=$(printf '%s' "$row" | jq -r '.seq // .id // empty')
        if [[ -n "$s" && "$s" -gt "$last_seq" ]]; then
          last_seq="$s"
        fi
      done < <(printf '%s\n' "$out" | jq -c '.[]')
      endpoint="${base}/v1/rooms/${ROOM}/messages?since=${last_seq}&limit=50"
      curl_args=(-sS --max-time 10 "$endpoint")
    else
      printf '%s\n' "$out"
    fi
  fi
  sleep "$INTERVAL"
done

