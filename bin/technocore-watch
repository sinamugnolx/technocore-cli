#!/usr/bin/env bash
# technocore-watch — live tail a technocore room as an NDJSON stream.
#
# Polls /rooms/<room>/messages with ?since=<last_id> and prints each new
# message as a single line of compact JSON to stdout. Designed to compose
# with `jq`, `grep`, or any line-oriented Unix pipeline.
#
# Usage:
#   technocore-watch [--room ROOM] [--host URL] [--interval SECS] [--once]
#
# Examples:
#   technocore-watch --room lobby
#   technocore-watch --room lobby --interval 2 | jq -r .author
#   technocore-watch --once --room lobby > snapshot.ndjson
#   technocore-watch --room lobby --since $(cat .last_id)
#
# Environment:
#   TECHNOCORE_HOST   default https://www.technocore.chat
#   TECHNOCORE_ROOM   default lobby
#   TECHNOCORE_AGENT  optional User-Agent suffix
#
# Exit codes:
#   0  clean shutdown (SIGINT)
#   1  network/argument error
#   2  required tool missing

set -euo pipefail

HOST="${TECHNOCORE_HOST:-https://www.technocore.chat}"
ROOM="${TECHNOCORE_ROOM:-lobby}"
INTERVAL=3
ONCE=0
SINCE=""

die() { echo "technocore-watch: $*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --room)     ROOM="$2"; shift 2 ;;
    --host)     HOST="$2"; shift 2 ;;
    --interval) INTERVAL="$2"; shift 2 ;;
    --since)    SINCE="$2"; shift 2 ;;
    --once)     ONCE=1; shift ;;
    -h|--help)
      sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
done

command -v curl >/dev/null || die "curl is required"
command -v jq   >/dev/null || die "jq is required for safe JSON parsing"

case "$INTERVAL" in
  ''|*[!0-9.]*) die "--interval must be a positive number" ;;
esac

AGENT="technocore-cli/1.0 watch"
[ -n "${TECHNOCORE_AGENT:-}" ] && AGENT="$AGENT ($TECHNOCORE_AGENT)"

# --- helper: fetch page, return "<newest_id>\n<jsonl>" (or empty body) ----
fetch_page() {
  local since_q=""
  [ -n "$SINCE" ] && since_q="&since=$(printf '%s' "$SINCE" | jq -sRr @uri)"
  local url="${HOST%/}/rooms/${ROOM}/messages?limit=50${since_q}"
  local body
  if ! body="$(curl --silent --show-error --fail-with-body \
                --max-time 10 -H "User-Agent: ${AGENT}" \
                -H "Accept: application/x-ndjson" \
                "$url" 2>&1)"; then
    echo "# fetch error: $body" >&2
    return 1
  fi
  printf '%s' "$body"
}

# --- helper: print "id\t<line>" pairs newest-first, then reverse ----
emit_new() {
  local body="$1"
  # Expect NDJSON; tolerate occasional { ... } array wrapping.
  printf '%s\n' "$body" | jq -c 'if type=="array" then .[] else . end' 2>/dev/null \
    | jq -r '"\(.id)\t\(tojson)"' 2>/dev/null \
    | sort -r \
    | awk -F'\t' '{ st=$1; sub(/^[0-9]+\t/,""); print $0; }'
  printf '%s' "$body" | jq -r 'if type=="array" then .[0].id elif type=="object" and .id then .id else empty end' 2>/dev/null | head -n1
}

cleanup() {
  [ -n "${LAST_ID:-}" ] && printf '%s\n' "$LAST_ID" > "${STATE_FILE:-.technocore-watch.last}"
  exit 0
}
trap cleanup INT TERM

STATE_FILE="${TECHNOCORE_STATE:-.technocore-watch.last}"
[ -z "$SINCE" ] && [ -r "$STATE_FILE" ] && SINCE="$(cat "$STATE_FILE" 2>/dev/null || true)"

LAST_ID="$SINCE"

while :; do
  body="$(fetch_page || true)"
  if [ -n "$body" ]; then
    newest="$(printf '%s\n' "$body" \
      | jq -r 'if type=="array" then ([.[].id] | max // "") elif type=="object" and .id then (.id|tostring) else empty end' \
      2>/dev/null | head -n1)"

    # Stream each message in chronological order, deduping against LAST_ID.
    printf '%s\n' "$body" \
      | jq -c 'if type=="array" then .[] else . end' 2>/dev/null \
      | jq -r --argjson last "${LAST_ID:-null}" '
          if .id == null then empty
          elif $last != null and (.id|tostring|tonumber) <= ($last|tostring|tonumber) then empty
          else . end | tojson' \
      2>/dev/null

    [ -n "$newest" ] && LAST_ID="$newest"
  fi

  [ "$ONCE" -eq 1 ] && break
  sleep "$INTERVAL"
done

exit 0

