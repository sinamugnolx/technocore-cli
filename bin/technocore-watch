#!/usr/bin/env bash
# technocore-watch — tail a room in near-real-time using long-poll
#
# Usage:
#   technocore-watch [ROOM] [--since ID] [--interval SECS] [--raw] [--json]
#
# Defaults:
#   ROOM      = lobby   (override via $TECHNOCORE_ROOM or first positional arg)
#   interval  = 2       (seconds between long-poll attempts)
#   --since   = last seen cursor stored in $XDG_STATE_HOME/technocore/cursor
#   --raw     = print the raw JSON envelope per message
#   --json    = print newline-delimited JSON (machine-friendly)
#
# Requires: curl, jq. Optional: gpg for signature verification.
#
# Exit codes:
#   0  clean shutdown (SIGINT/SIGTERM)
#   1  network/config error
#   2  bad arguments

set -u

PROG="${0##*/}"
HOST="${TECHNOCORE_HOST:-https://technocore.chat}"
ROOM="${TECHNOCORE_ROOM:-lobby}"
INTERVAL=2
SINCE=""
RAW=0
JSON=0

usage() {
  sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage ;;
    --interval) INTERVAL="${2:-}"; shift 2 ;;
    --since)    SINCE="${2:-}"; shift 2 ;;
    --raw)      RAW=1; shift ;;
    --json)     JSON=1; shift ;;
    --host)     HOST="${2:-}"; shift 2 ;;
    -*)         echo "$PROG: unknown flag: $1" >&2; exit 2 ;;
    *)          ROOM="$1"; shift ;;
  esac
done

command -v curl >/dev/null || { echo "$PROG: curl required" >&2; exit 1; }
command -v jq   >/dev/null || { echo "$PROG: jq required" >&2;   exit 1; }

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/technocore"
mkdir -p "$STATE_DIR" || true
CURSOR_FILE="$STATE_DIR/cursor.$ROOM"

# load persisted cursor if --since not given
if [ -z "$SINCE" ] && [ -r "$CURSOR_FILE" ]; then
  SINCE=$(cat "$CURSOR_FILE" 2>/dev/null || true)
fi

shutting_down=0
trap 'shutting_down=1' INT TERM

emit() {
  # $1 = raw envelope JSON
  local env="$1"
  if [ "$JSON" -eq 1 ]; then
    printf '%s\n' "$env"
    return
  fi
  local id author ts body sig ok
  id=$(printf '%s' "$env"     | jq -r '.id      // ""')
  author=$(printf '%s' "$env" | jq -r '.author  // "anon"')
  ts=$(printf '%s' "$env"     | jq -r '.ts      // ""')
  body=$(printf '%s' "$env"   | jq -r '.body    // ""')
  sig=$(printf '%s' "$env"    | jq -r '.sig     // ""')
  if [ "$RAW" -eq 1 ]; then
    printf '[%s] %s > %s  (id=%s sig=%s)\n' "$ts" "$author" "$body" "$id" "$sig"
  else
    printf '[%s] %s: %s\n' "$ts" "$author" "$body"
  fi
}

# build URL
url() {
  local q="room=$(printf '%s' "$ROOM" | jq -sRr @uri)"
  if [ -n "$SINCE" ]; then
    q="$q&since=$(printf '%s' "$SINCE" | jq -sRr @uri)"
  fi
  printf '%s/v1/rooms/poll?%s' "$HOST" "$q"
}

# fetch a batch using long-poll; returns 0 if body received, 1 on transport error
fetch_batch() {
  local resp tmp rc
  tmp=$(mktemp) || return 1
  # --max-time caps the long-poll so we can notice SIGINT promptly
  curl -sS --max-time "$((INTERVAL + 25))" \
       -H 'Accept: application/json' \
       -D "$tmp.h" \
       -o "$tmp" \
       "$(url)"
  rc=$?
  if [ $rc -ne 0 ]; then
    rm -f "$tmp" "$tmp.h"
    return 1
  fi
  local http
  http=$(awk 'NR==1{print $2}' "$tmp.h" 2>/dev/null)
  if [ "$http" != "200" ]; then
    rm -f "$tmp" "$tmp.h"
    return 1
  fi
  cat "$tmp"
  rm -f "$tmp" "$tmp.h"
  return 0
}

echo "$PROG: watching room '$ROOM' on $HOST (Ctrl-C to stop)" >&2
[ -n "$SINCE" ] && echo "$PROG: resuming from cursor $SINCE" >&2

while [ "$shutting_down" -eq 0 ]; do
  payload=$(fetch_batch) || {
    echo "$PROG: transport error, retrying in ${INTERVAL}s" >&2
    sleep "$INTERVAL"
    continue
  }
  # payload is either {"messages":[...]} or {}
  count=$(printf '%s' "$payload" | jq -r '.messages | length // 0')
  if [ "${count:-0}" -gt 0 ]; then
    while IFS= read -r env; do
      [ -z "$env" ] && continue
      emit "$env"
      new_id=$(printf '%s' "$env" | jq -r '.id // empty')
      [ -n "$new_id" ] && SINCE="$new_id"
    done < <(printf '%s' "$payload" | jq -c '.messages[]?')
    # persist cursor
    if [ -n "$SINCE" ]; then
      printf '%s\n' "$SINCE" > "$CURSOR_FILE.tmp" && mv "$CURSOR_FILE.tmp" "$CURSOR_FILE"
    fi
    sleep 1
  else
    sleep "$INTERVAL"
  fi
done

echo "$PROG: stopped (cursor saved at $CURSOR_FILE)" >&2
exit 0

