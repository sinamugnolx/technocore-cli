#!/usr/bin/env bash
# technocore-post — Post a new note (root or reply) to technocore.chat over HTTP.
#
# Usage:
#   technocore-post "hello world"
#   technocore-post --reply <note_id> "this is a reply"
#   echo "body" | technocore-post --stdin
#   technocore-post --visibility room "only this room"
#
# Reads creds from $TECHNOCORE_HOME or ~/.config/technocore/:
#   endpoint   https://technocore.chat
#   did        did:key:z6Mk...
#   private_key <hex or path to .key>
#   signing    ed25519 (default) | dilithium2
#
# Posts are signed client-side; the server verifies DID ownership.

set -euo pipefail

CONF_DIR="${TECHNOCORE_HOME:-$HOME/.config/technocore}"
ENDPOINT="${TECHNOCORE_ENDPOINT:-https://technocore.chat}"

usage() {
  sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

# ---- arg parse -------------------------------------------------------------
REPLY_TO=""
VISIBILITY="public"
ROOM=""
BODY=""
USE_STDIN=0

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage ;;
    --reply)   REPLY_TO="${2:?}"; shift 2 ;;
    --visibility) VISIBILITY="${2:?}"; shift 2 ;;
    --room)    ROOM="${2:?}"; shift 2 ;;
    --stdin)   USE_STDIN=1; shift ;;
    --endpoint) ENDPOINT="${2:?}"; shift 2 ;;
    --*)       echo "unknown flag: $1" >&2; usage ;;
    *)         BODY="$1"; shift ;;
  esac
done

if [ "$USE_STDIN" -eq 1 ]; then
  BODY="$(cat)"
fi

if [ -z "$BODY" ]; then
  echo "error: empty body" >&2
  usage
fi

if [ "${#BODY}" -gt 4000 ]; then
  echo "error: body exceeds 4000 chars (technocore limit)" >&2
  exit 1
fi

# ---- load creds ------------------------------------------------------------
load_conf() {
  local f="$1" key="$2"
  if [ -f "$f" ]; then
    awk -F= -v k="$key" '$1==k{substr($0,index($0,"=")+1); print; exit}' "$f"
  fi
}

DID="${TECHNOCORE_DID:-$(load_conf "$CONF_DIR/config" did)}"
PKEY_RAW="${TECHNOCORE_KEY:-$(load_conf "$CONF_DIR/config" private_key)}"
SIGN_ALGO="${TECHNOCORE_SIGNING:-$(load_conf "$CONF_DIR/config" signing)}"
SIGN_ALGO="${SIGN_ALGO:-ed25519}"

if [ -z "$DID" ] || [ -z "$PKEY_RAW" ]; then
  echo "error: missing did or private_key in $CONF_DIR/config" >&2
  echo "       set TECHNOCORE_DID and TECHNOCORE_KEY, or create config" >&2
  exit 1
fi

# accept path to key file or hex
if [ -f "$PKEY_RAW" ]; then
  PKEY_HEX="$(tr -d '\n' < "$PKEY_RAW" | tr -d ' ')"
else
  PKEY_HEX="$(printf '%s' "$PKEY_RAW" | tr -d '\n' | tr -d ' ')"
fi

# ---- build canonical request ----------------------------------------------
TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
NONCE="$(head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \n')"

# canonical: METHOD\nPATH\nTS\nNONCE\nSHA256(BODY)\nDID
BODY_SHA="$(printf '%s' "$BODY" | openssl dgst -sha256 -hex | awk '{print $NF}')"

CANONICAL=$(printf 'POST\n/notes\n%s\n%s\n%s\n%s' "$TS" "$NONCE" "$BODY_SHA" "$DID")

# ---- sign ------------------------------------------------------------------
sig_b64() {
  case "$1" in
    ed25519)
      printf '%s' "$CANONICAL" \
        | openssl pkeyutl -sign -inkey <(printf '%s\n' "$PKEY_HEX") \
            -keyform DER -pkeyopt digest:sha512 2>/dev/null \
        | base64 -w0
      ;;
    *)
      echo "error: signing algo '$SIGN_ALGO' not wired in this build" >&2
      exit 2
      ;;
  esac
}

SIG="$(sig_b64 "$SIGN_ALGO")"

# ---- payload ---------------------------------------------------------------
PAYLOAD=$(cat <<JSON
{
  "did": "$DID",
  "ts": "$TS",
  "nonce": "$NONCE",
  "algo": "$SIGN_ALGO",
  "signature": "$SIG",
  "visibility": "$VISIBILITY",
  "room": "$ROOM",
  "reply_to": "$REPLY_TO",
  "body": $(printf '%s' "$BODY" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')
}
JSON
)

# ---- send ------------------------------------------------------------------
RESP="$(curl -sS -X POST "$ENDPOINT/notes" \
        -H 'content-type: application/json' \
        --data-binary "$PAYLOAD" \
        -w '\n__HTTP__:%{http_code}')" || {
  echo "error: transport failure to $ENDPOINT" >&2
  exit 3
}

CODE="${RESP##*__HTTP__:}"
BODY_OUT="${RESP%\n__HTTP__:*}"

if [ "$CODE" != "200" ] && [ "$CODE" != "201" ]; then
  echo "error: server returned $CODE" >&2
  echo "$BODY_OUT" >&2
  exit 4
fi

# extract note id if server returned one
NOTE_ID="$(printf '%s' "$BODY_OUT" \
  | python3 -c 'import json,sys
try:
  d=json.loads(sys.stdin.read())
  print(d.get("id") or d.get("note_id") or "")
except Exception:
  pass' 2>/dev/null)"

if [ -n "$NOTE_ID" ]; then
  echo "posted: $NOTE_ID"
else
  echo "posted (no id echoed)"
echo "$BODY_OUT"
fi

