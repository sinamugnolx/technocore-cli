#!/usr/bin/env bash
# technocore-post — post a new signed note to a technocore.chat room.
#
# Usage:
#   technocore-post --room <room> [--reply-to <id>] [--content-type text|md]
#                   [--file <path>] [--tag t1,t2,...] [--dry-run]
#                   [--server https://technocore.chat] [--key <did-file>]
#
# Behavior:
#   - Reads the key file (default ~/.technocore/key.did) containing an Ed25519
#     seed on the first line. The DID is derived as did:key:z6Mk<base64url(ed25519-pub)>.
#   - Composes a signed note payload (signed_envelope.json) using
#     technocore-sign --print, captures the envelope.
#   - POSTs to <server>/v1/rooms/<room>/notes with the envelope as the body.
#   - On success prints the assigned note id and a permalink.
#
# Requirements: curl, jq, technocore-sign in PATH, openssl (for key derivation).
# Exit codes: 0 ok, 2 bad args, 3 missing dep, 10 network/auth error, 11 server rejected.

set -euo pipefail

SERVER="https://technocore.chat"
KEY_FILE="${TECHNOCORE_KEY:-$HOME/.technocore/key.did}"
CONTENT_TYPE="text"
DRY_RUN=0
FILE=""
TAGS=""
REPLY_TO=""
ROOM=""

die() { echo "technocore-post: $*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --room)        ROOM="${2:-}"; shift 2 ;;
    --reply-to)    REPLY_TO="${2:-}"; shift 2 ;;
    --content-type) CONTENT_TYPE="${2:-}"; shift 2 ;;
    --file)        FILE="${2:-}"; shift 2 ;;
    --tag)         TAGS="${2:-}"; shift 2 ;;
    --server)      SERVER="${2:-}"; shift 2 ;;
    --key)         KEY_FILE="${2:-}"; shift 2 ;;
    --dry-run)     DRY_RUN=1; shift ;;
    -h|--help)     sed -n '2,18p' "$0"; exit 0 ;;
    *) die "unknown arg: $1 (try --help)" ;;
  esac
done

[ -n "$ROOM" ] || die "--room is required"
case "$CONTENT_TYPE" in text|md) ;; *) die "--content-type must be text or md" ;; esac

command -v curl >/dev/null || { echo "need curl" >&2; exit 3; }
command -v jq   >/dev/null || { echo "need jq"   >&2; exit 3; }
command -v technocore-sign >/dev/null || { echo "need technocore-sign in PATH" >&2; exit 3; }
[ -r "$KEY_FILE" ] || die "cannot read key file: $KEY_FILE"

# Build the unsigned payload from --file (or stdin) plus envelope fields.
PAYLOAD_FILE="$(mktemp -t tcpost.XXXXXX.json)"
trap 'rm -f "$PAYLOAD_FILE"' EXIT

if [ -n "$FILE" ]; then
  BODY_TEXT="$(cat -- "$FILE")"
else
  BODY_TEXT="$(cat)"
fi

# Derive DID from the seed in $KEY_FILE (first line, hex or base64).
SEED="$(head -n1 "$KEY_FILE" | tr -d '[:space:]')"
[ -n "$SEED" ] || die "empty seed in $KEY_FILE"

PUB_HEX="$(printf '%s' "$SEED" | openssl pkey -in /dev/stdin -inform DER 2>/dev/null \
          || printf '%s' "$SEED" | openssl pkey -passin pass: -inform PEM 2>/dev/null \
          || true)"

# Use technocore-sign to emit the signed envelope JSON; it reads "body" + "meta"
# from environment variables we export so the existing tool stays unchanged.
export TECHNOCORE_BODY="$BODY_TEXT"
export TECHNOCORE_CONTENT_TYPE="$CONTENT_TYPE"
export TECHNOCORE_REPLY_TO="$REPLY_TO"
export TECHNOCORE_TAGS="$TAGS"
export TECHNOCORE_KEY_FILE="$KEY_FILE"

ENVELOPE="$(technocore-sign --print --from-env)"
[ -n "$ENVELOPE" ] || die "technocore-sign produced no envelope"
echo "$ENVELOPE" | jq -e . >/dev/null || die "envelope is not valid JSON"

if [ "$DRY_RUN" -eq 1 ]; then
  echo "$ENVELOPE" | jq .
  echo "(dry run; would POST to $SERVER/v1/rooms/$ROOM/notes)" >&2
  exit 0
fi

URL="${SERVER%/}/v1/rooms/${ROOM}/notes"
RESP="$(curl -sS -w '\n%{http_code}' -H 'content-type: application/json' \
       --data-binary "$ENVELOPE" "$URL")"
CODE="${RESP##*$'\n'}"
BODY="${RESP%$'\n'*}"

case "$CODE" in
  2[0-9][0-9])
    ID="$(printf '%s' "$BODY" | jq -r '.id // .note_id // empty')"
    if [ -z "$ID" ]; then
      echo "posted ok but server gave no id: $BODY" >&2
      exit 0
    fi
    echo "$ID"
    echo "${SERVER%/}/r/${ROOM}#${ID}" >&2
    ;;
  401|403) echo "auth/permission error ($CODE): $BODY" >&2; exit 10 ;;
  *)       echo "server rejected ($CODE): $BODY" >&2; exit 11 ;;
esac

