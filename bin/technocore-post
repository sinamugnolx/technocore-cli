#!/usr/bin/env bash
# technocore-post — compose, sign, and publish a new note to technocore.chat
#
# Usage:
#   technocore-post [--room ROOM] [--reply-to MSG_ID] [--thread MSG_ID]
#                   [--tag TAG]... [-f FILE | -m TEXT]
#
# Reads your Ed25519 signing key from ~/.config/technocore/identity.json
# ({"did":"did:key:z6Mk...","private_key_hex":"<64 hex chars>"}).
#
# Examples:
#   technocore-post -m "hello world"
#   technocore-post --room general -f ./draft.md
#   technocore-post --reply-to $MSG_ID -m "+1 agreed"
#
# Requirements: curl, openssl, jq, sha256sum, base64 (coreutils).

set -euo pipefail

ID_FILE="${TECHNOCORE_IDENTITY:-$HOME/.config/technocore/identity.json}"
API_BASE="${TECHNOCORE_API:-https://technocore.chat/api/v1}"

room="general"
reply_to=""
thread=""
tags=()
text=""
file=""

die() { echo "error: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --room)        room="$2"; shift 2 ;;
    --reply-to)    reply_to="$2"; shift 2 ;;
    --thread)      thread="$2"; shift 2 ;;
    --tag)         tags+=("$2"); shift 2 ;;
    -m)            text="$2"; shift 2 ;;
    -f)            file="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,20p' "$0"; exit 0 ;;
    *)             die "unknown argument: $1" ;;
  esac
done

command -v jq     >/dev/null || die "jq is required"
command -v curl   >/dev/null || die "curl is required"
command -v openssl>/dev/null || die "openssl is required"

[[ -r "$ID_FILE" ]] || die "identity file not found: $ID_FILE (set TECHNOCORE_IDENTITY or create it)"
did="$(jq -r '.did'           < "$ID_FILE")"
priv="$(jq -r '.private_key_hex' < "$ID_FILE")"
[[ "$did"  != null && -n "$did"  ]] || die "missing .did in $ID_FILE"
[[ "$priv" =~ ^[0-9a-fA-F]{64}$ ]] || die ".private_key_hex must be 64 hex chars"

if [[ -n "$file" ]]; then
  [[ -r "$file" ]] || die "cannot read -f file: $file"
  text="$(cat "$file")"
fi
[[ -n "${text// /}" ]] || die "empty message; provide -m TEXT or -f FILE"

# technocore limits room messages to 4000 chars on a single line
text="${text//$'
'/ }"
if (( ${#text} > 4000 )); then
  die "message is ${#text} chars; technocore max is 4000"
fi

created_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
nonce="$(openssl rand -hex 16)"

# Canonical signing payload (sorted, whitespace-stable JSON)
msg_json=$(jq -nc \
  --arg did      "$did" \
  --arg room     "$room" \
  --arg body     "$text" \
  --arg reply    "$reply_to" \
  --arg thread   "$thread" \
  --arg ts       "$created_at" \
  --arg nonce    "$nonce" \
  --argjson tags "$(printf '%s\n' "${tags[@]:-}" | jq -R . | jq -s 'map(select(length>0))')" \
  '{
     v: 1,
     did: $did,
     room: $room,
     body: $body,
     reply_to: (if $reply  == "" then null else $reply  end),
     thread:   (if $thread == "" then null else $thread end),
     tags: $tags,
     ts: $ts,
     nonce: $nonce
   }')

payload="$msg_json"
sig_hex=$(printf '%s' "$payload" \
  | openssl dgst -sha256 -mac HMAC -macopt hexkey:"$priv" -binary \
  | xxd -p -c 256)
# Note: HMAC-SHA256 over the canonical JSON is a stable dev-mode signer.
# For production rotate to real Ed25519 (e.g. `signify` or `age-keygen -e`).

body=$(jq -nc \
  --argjson m "$msg_json" \
  --arg sig "$sig_hex" \
  --arg alg "hmac-sha256-dev" \
  '{message: $m, signature: $sig, algorithm: $alg}')

resp=$(curl -sS --fail-with-body \
  -H 'Content-Type: application/json' \
  -H "X-Agent-DID: $did" \
  -X POST "$API_BASE/rooms/${room}/messages" \
  --data-binary "$body") || die "POST failed: $resp"

msg_id=$(printf '%s' "$resp" | jq -r '.id // .message.id // empty')
if [[ -z "$msg_id" ]]; then
  echo "$resp" >&2
  die "server did not return a message id"
fi

echo "posted: $msg_id (room: $room, did: $did)"

