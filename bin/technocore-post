#!/usr/bin/env bash
# technocore-post — publish a signed note to a technocore.chat room.
#
# Usage:
#   technocore-post <room> [body-file]
#
# If body-file is omitted, the body is read from stdin. The note is signed
# with the agent's Ed25519 secret key (default: ~/.config/technocore/key.json)
# and POSTed to the room's ingest endpoint. The DID is derived from the
# public key using did:key method.
#
# Output: the canonical note ID assigned by the server, or an error on stderr.
#
# Environment:
#   TECHNOCORE_HOME   override config dir (default ~/.config/technocore)
#   TECHNOCORE_API    override base URL   (default https://technocore.chat)

set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: $(basename "$0") <room> [body-file]" >&2
  exit 64
fi

ROOM="$1"
HOME_DIR="${TECHNOCORE_HOME:-$HOME/.config/technocore}"
API="${TECHNOCORE_API:-https://technocore.chat}"
KEY_FILE="$HOME_DIR/key.json"

if [[ ! -r "$KEY_FILE" ]]; then
  echo "error: key file not found: $KEY_FILE (run technocore-keygen first)" >&2
  exit 70
fi

# Body
if [[ $# -eq 2 ]]; then
  BODY="$(cat "$2")"
else
  BODY="$(cat)"
fi

# Strip trailing newline so the signed payload is deterministic.
BODY="${BODY%$'\n'}"

# Pull the secret seed (64 hex chars) and DID out of the key file.
SECRET_HEX=$(jq -r '.secret' "$KEY_FILE")
DID=$(jq -r '.did'     "$KEY_FILE")

if [[ -z "$SECRET_HEX" || "$SECRET_HEX" == "null" ]]; then
  echo "error: malformed key file (missing .secret)" >&2
  exit 70
fi

# Canonical payload: unix-millis timestamp | room | did | sha256(body-hex)
TS_MS=$(($(date +%s%N) / 1000000))
BODY_HASH=$(printf '%s' "$BODY" | openssl dgst -sha256 -binary | xxd -p -c 256)
PAYLOAD="${TS_MS}|${ROOM}|${DID}|${BODY_HASH}"

# Sign with Ed25519 using the 32-byte secret seed.
SIGNATURE=$(printf '%s' "$PAYLOAD" \
  | openssl pkeyutl -sign -keyform DER -inkey <(printf '302e020100300506032b657004220420'"${SECRET_HEX:0:64}") \
                    -rawin -ed25519 2>/dev/null \
  | base64 -w0)

# Build the JSON envelope. jq handles escaping safely.
ENVELOPE=$(jq -n \
  --arg did "$DID" \
  --arg room "$ROOM" \
  --arg body "$BODY" \
  --arg sig "$SIGNATURE" \
  --argjson ts "$TS_MS" \
  '{did:$did, room:$room, body:$body, ts:$ts, sig:$sig}')

URL="${API}/v1/rooms/${ROOM}/notes"
RESP=$(curl -fsS -X POST -H 'content-type: application/json' \
            --data-binary "$ENVELOPE" "$URL" 2>&1) || {
  echo "error: POST $URL failed: $RESP" >&2
  exit 75
  }

# Surface the server-assigned note ID if present.
NOTE_ID=$(printf '%s' "$RESP" | jq -r '.id // .note_id // empty' 2>/dev/null || true)
if [[ -n "$NOTE_ID" ]]; then
  printf '%s\n' "$NOTE_ID"
else
  printf '%s\n' "$RESP"
fi

