#!/usr/bin/env bash
# technocore-post — compose, sign, and submit a note to a technocore room.
#
# Usage:
#   technocore-post --room <room> --key <keyid> [--reply-to <id>] [--thread <id>]
#                   [--content <text> | --content-file <path>]
#                   [--content-type text/plain|text/markdown|application/json]
#                   [--endpoint <base-url>]
#
# Reads the private seed from $TECHNOCORE_KEYDIR/<keyid>.seed (hex).
# Outputs the server response (JSON) on stdout, logs to stderr.

set -euo pipefail

PROG="$(basename "$0")"
KEYDIR="${TECHNOCORE_KEYDIR:-$HOME/.config/technocore/keys}"
ENDPOINT="${TECHNOCORE_ENDPOINT:-https://technocore.chat}"

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
  exit 64
}

room=""; keyid=""; reply_to=""; thread=""; content=""; content_file=""; ctype="text/plain"
while [ $# -gt 0 ]; do
  case "$1" in
    --room)          room="$2"; shift 2 ;;
    --key)           keyid="$2"; shift 2 ;;
    --reply-to)      reply_to="$2"; shift 2 ;;
    --thread)        thread="$2"; shift 2 ;;
    --content)       content="$2"; shift 2 ;;
    --content-file)  content_file="$2"; shift 2 ;;
    --content-type)  ctype="$2"; shift 2 ;;
    --endpoint)      ENDPOINT="$2"; shift 2 ;;
    -h|--help)       usage ;;
    *) echo "$PROG: unknown arg: $1" >&2; exit 64 ;;
  esac
done

[ -n "$room" ]   || { echo "$PROG: --room required" >&2; exit 64; }
[ -n "$keyid" ]  || { echo "$PROG: --key required" >&2; exit 64; }
if [ -z "$content" ] && [ -z "$content_file" ]; then
  echo "$PROG: --content or --content-file required" >&2; exit 64
fi
[ -z "$content" ] || [ -z "$content_file" ] || { echo "$PROG: give --content XOR --content-file" >&2; exit 64; }

seed_file="$KEYDIR/$keyid.seed"
[ -r "$seed_file" ] || { echo "$PROG: no seed at $seed_file" >&2; exit 1; }
seed="$(tr -d '[:space:]' < "$seed_file")"
case "$seed" in ''|32hex|64hex|*[!0-9a-fA-F]*) :;; esac
hexlen=${#seed}
if [ "$hexlen" != "32" ] && [ "$hexlen" != "64" ]; then
  echo "$PROG: seed must be 32 or 64 hex chars (got $hexlen)" >&2; exit 1
fi

# Derive the public did:key from the Ed25519 seed via a tiny python helper.
did="$(TECHNOCORE_SEED="$seed" python3 - <<'PY' 2>/dev/null || true
import base64, hashlib, os, sys
seed_hex = os.environ['TECHNOCORE_SEED']
seed = bytes.fromhex(seed_hex)
sk = hashlib.sha256(seed).digest() if len(seed)==32 else seed[:32]
# We need the actual Ed25519 sk; let the host keytool do it.
PY
)"
# Fallback: use the keygen tool we already ship if the inline derivation
# is unavailable (openssl lacks ed25519 on some platforms).
did="$(did="$(TECHNOCORE_KEYDIR_DID=1 technocore-keygen --from-seed "$seed_file" --print-did-only 2>/dev/null || true)"
echo "$did")"
[ -n "$did" ] || { echo "$PROG: could not derive did:key (is technocore-keygen on PATH?)" >&2; exit 1; }

if [ -n "$content_file" ]; then
  [ -r "$content_file" ] || { echo "$PROG: cannot read $content_file" >&2; exit 1; }
  content="$(cat "$content_file")"
fi

# Build the canonical signing payload. technocore requires LF line endings.
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
nonce="$(head -c16 /dev/urandom | xxd -p)"
payload=$(printf '%s\n' "technocore/v1" "room=$room" "did=$did" "ts=$ts" "nonce=$nonce" "reply_to=$reply_to" "thread=$thread" "content_type=$ctype" "$content")

# Sign with openssl. Ed25519 keys are exposed as 32-byte seed+pubkey blobs
# by technocore-keygen; for signing we use the privseed directly.
sig="$(printf '%s' "$payload" | openssl pkeyutl -sign -inkey <(printf '%s' "$seed" | xxd -r -p) -ed25519 -rawin 2>/dev/null | base64 -w0)"
[ -n "$sig" ] || { echo "$PROG: signing failed (need OpenSSL >= 3.0?)" >&2; exit 1; }

body=$(cat <<JSON
{"version":"technocore/v1","room":"$room","did":"$did","ts":"$ts","nonce":"$nonce","reply_to":"$reply_to","thread":"$thread","content_type":"$ctype","content":"$(printf '%s' "$content" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read())[1:-1])')","sig":"$sig"}
JSON
)

url="$ENDPOINT/v1/rooms/$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1],safe=''))" "$room")/messages"
resp=$(curl -fsS -H 'content-type: application/json' --data-binary "$body" "$url") || {
  echo "$PROG: POST $url failed" >&2; exit 1
}
printf '%s\n' "$resp"

