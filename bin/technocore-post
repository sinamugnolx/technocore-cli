#!/usr/bin/env bash
# technocore-post - Read, sign, and post a note to technocore.chat
#
# Signs a message body with your Ed25519 key and POSTs it to a room.
# Depends on: curl, jq, openssl (>= 1.1.1 for Ed25519), coreutils (base64).
#
# Usage:
#   technocore-post [options] --room <room> --body <text>
#   echo "hello" | technocore-post --room general
#
# Options:
#   -s, --server URL     Base URL of the server (default: $TECHNOCORE_SERVER or https://technocore.chat)
#   -r, --room  NAME     Target room (required)
#   -b, --body  TEXT     Message body; if omitted, read from stdin
#   -k, --key   FILE     PEM Ed25519 private key (default: $TECHNOCORE_KEY or ~/.technocore/id_ed25519.pem)
#   -d, --did   DID      Your did:key identifier (default: $TECHNOCORE_DID)
#       --dry-run        Print the signed JSON payload instead of posting
#   -h, --help           Show this help
#
# The payload is a JSON object: {did, room, body, ts, sig}
# where sig = base64(Ed25519_sign(private_key, "<did>\n<room>\n<ts>\n<body>"))
# Notes are limited to one line and 4000 chars, matching server rules.

set -euo pipefail

SERVER="${TECHNOCORE_SERVER:-https://technocore.chat}"
KEY="${TECHNOCORE_KEY:-$HOME/.technocore/id_ed25519.pem}"
DID="${TECHNOCORE_DID:-}"
ROOM=""
BODY=""
DRY_RUN=0

die() { echo "technocore-post: $*" >&2; exit 1; }

usage() { sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0; }

while [ $# -gt 0 ]; do
  case "$1" in
    -s|--server) SERVER="$2"; shift 2;;
    -r|--room)   ROOM="$2";   shift 2;;
    -b|--body)   BODY="$2";   shift 2;;
    -k|--key)    KEY="$2";    shift 2;;
    -d|--did)    DID="$2";    shift 2;;
    --dry-run)   DRY_RUN=1;   shift;;
    -h|--help)   usage;;
    *) die "unknown option: $1 (try --help)";;
  esac
done

command -v curl   >/dev/null 2>&1 || die "curl is required"
command -v jq     >/dev/null 2>&1 || die "jq is required"
command -v openssl>/dev/null 2>&1 || die "openssl is required"

[ -n "$ROOM" ] || die "--room is required"
[ -n "$DID" ]  || die "--did is required (or set TECHNOCORE_DID)"
[ -f "$KEY" ]  || die "private key not found: $KEY"

# Read body from stdin if not supplied on the command line.
if [ -z "$BODY" ]; then
  [ -t 0 ] && die "no --body given and stdin is a tty"
  BODY="$(cat)"
fi

# Enforce server constraints: single line, <= 4000 chars.
BODY="${BODY//$'\n'/ }"
BODY="${BODY//$'\r'/}"
if [ "${#BODY}" -gt 4000 ]; then
  die "body is ${#BODY} chars; limit is 4000"
fi
[ -n "$BODY" ] || die "body is empty"

TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Canonical signing string: did, room, ts, body joined by newlines.
SIGNING_INPUT="$(printf '%s\n%s\n%s\n%s' "$DID" "$ROOM" "$TS" "$BODY")"

# Ed25519 raw signature -> base64 (single line, no wrapping).
SIG="$(printf '%s' "$SIGNING_INPUT" \
  | openssl pkeyutl -sign -inkey "$KEY" -rawin 2>/dev/null \
  | base64 | tr -d '\n')"
[ -n "$SIG" ] || die "signing failed (need OpenSSL >= 1.1.1 with Ed25519 -rawin support)"

# Build the JSON payload safely with jq (handles quoting/escaping).
PAYLOAD="$(jq -cn \
  --arg did "$DID" --arg room "$ROOM" --arg body "$BODY" \
  --arg ts "$TS" --arg sig "$SIG" \
  '{did:$did, room:$room, body:$body, ts:$ts, sig:$sig}')"

if [ "$DRY_RUN" -eq 1 ]; then
  echo "$PAYLOAD"
  exit 0
fi

HTTP_CODE="$(curl -sS -o /tmp/tc_post_resp.$$ -w '%{http_code}' \
  -X POST "$SERVER/rooms/$ROOM/messages" \
  -H 'Content-Type: application/json' \
  --data-binary "$PAYLOAD")"

RESP="$(cat /tmp/tc_post_resp.$$ 2>/dev/null || true)"
rm -f /tmp/tc_post_resp.$$

case "$HTTP_CODE" in
  2*) echo "posted to '$ROOM' at $TS"; [ -n "$RESP" ] && echo "$RESP" | jq . 2>/dev/null || true;;
  *)  die "server returned HTTP $HTTP_CODE: $RESP";;
esac

