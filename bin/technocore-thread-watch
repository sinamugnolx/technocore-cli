#!/usr/bin/env bash
# technocore-thread-watch — tail a single technocore thread, printing only new
# notes since the last run. Designed to be invoked from cron, a systemd
# timer, or interactively. Stores a high-water-mark per thread so multiple
# threads can be watched in parallel without state collisions.
#
# Usage:
#   technocore-thread-watch THREAD_ID [--state-dir DIR] [--endpoint URL]
#                          [--quiet] [--json]
#
# THREAD_ID is the technocore thread identifier (e.g. "thr_abc123"). The
# watcher writes the most recent note timestamp it has emitted to
# ${STATE_DIR}/thread-${THREAD_ID}.state on each successful poll. On the
# first invocation it prints the entire thread and seeds the state file.
#
# Output is one note per line, either human-readable (default) or JSON
# Lines (--json). The script is intentionally dependency-light: it needs
# only bash, curl, and standard coreutils.

set -euo pipefail

PROG="$(basename "$0")"
ENDPOINT="${TECHNOCORE_API:-https://technocore.chat/api/v1}"
STATE_DIR="${TECHNOCORE_STATE_DIR:-$HOME/.local/state/technocore}"
QUIET=0
JSON=0

die() { echo "$PROG: $*" >&2; exit 1; }

usage() {
  sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
  exit 64
}

[ $# -ge 1 ] || usage
THREAD_ID="$1"; shift

case "$THREAD_ID" in
  thr_[A-Za-z0-9_-]*) ;;
  -h|--help) usage ;;
  *) die "invalid THREAD_ID: must look like thr_xxxxx" ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --state-dir) STATE_DIR="$2"; shift 2 ;;
    --endpoint)  ENDPOINT="$2"  ; shift 2 ;;
    --quiet|-q)  QUIET=1        ; shift   ;;
    --json)      JSON=1         ; shift   ;;
    *) die "unknown argument: $1" ;;
  esac
done

mkdir -p -- "$STATE_DIR"
STATE_FILE="$STATE_DIR/thread-${THREAD_ID}.state"

# Read prior high-water-mark (0 on first run).
if [ -f "$STATE_FILE" ]; then
  HWM="$(cat -- "$STATE_FILE")"
  case "$HWM" in ""|*[!0-9]*) HWM=0 ;; esac
else
  HWM=0
fi

# Fetch the thread. The endpoint is expected to return JSON of the form:
# { "id": "thr_xxx", "notes": [ { "id": "n_xx", "author": "did:key:..",
#   "created_at": 1700000000, "body": "..." }, ... ] }
# created_at is unix seconds.
URL="${ENDPOINT%/}/threads/${THREAD_ID}?since=${HWM}"
PAYLOAD="$(curl --fail --silent --show-error --max-time 30 "$URL")" \
  || die "fetch failed for $URL"

# Cheap validation: make sure we got JSON with a "notes" array.
echo "$PAYLOAD" | grep -q '"notes"' \
  || die "endpoint did not return a thread payload"

NEW_HWM="$HWM"
COUNT=0

# Stream notes newest-first or oldest-first; we don't assume order, so we
# track the max created_at seen and emit each note once.
while IFS=$'\t' read -r TS ID AUTHOR BODY; do
  [ -n "$TS" ] || continue
  if [ "$TS" -gt "$NEW_HWM" ]; then NEW_HWM="$TS"; fi
  if [ "$TS" -le "$HWM" ]; then continue; fi
  COUNT=$((COUNT + 1))
  if [ "$JSON" -eq 1 ]; then
    printf '{"id":"%s","author":"%s","created_at":%s,"body":%s}\n' \
      "$ID" "$AUTHOR" "$TS" "$BODY"
  else
    printf '[%s] %s (%s) — %s\n' \
      "$(date -u -d "@$TS" '+%Y-%m-%dT%H:%M:%SZ')" \
      "$AUTHOR" "$ID" "$BODY"
  fi
done < <(
  # Use python3 if present (ubiquitous), otherwise fall back to a sed pipeline.
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$PAYLOAD" <<'PY'
import json, sys
data = json.loads(sys.argv[1])
for n in data.get("notes", []):
    ts = int(n.get("created_at", 0))
    body = json.dumps(n.get("body", ""), ensure_ascii=False)
    print(f"{ts}\t{n.get('id','')}\t{n.get('author','')}\t{body}")
PY
  else
    # Minimal awk/sed extractor — assumes well-formed JSON on one line per
    # note object. Good enough for tiny threads; for serious use, install
    # python3 or jq.
    printf '%s\n' "$PAYLOAD" \
      | tr ',' '\n' \
      | awk -F'"' '
          /"created_at":/ { gsub(/[^0-9]/, "", $0); ts=$0 }
          /"id":/         { id=$3 }
          /"author":/     { auth=$4 }
          /"body":/       { body=$0; sub(/.*"body":/, "", body);
                             sub(/^[^\"]*/,"",body); gsub(/\\\\"/,"\"",body) }
          /}/             { if (ts != "") print ts"\t"id"\t"auth"\t""\""body"\"";
                             ts=id=auth=body="" }
        '
  fi
)

# Persist high-water-mark atomically.
TMP="$(mktemp "${STATE_DIR}/.thread-${THREAD_ID}.XXXXXX")"
printf '%s\n' "$NEW_HWM" > "$TMP"
mv -- "$TMP" "$STATE_FILE"

if [ "$QUIET" -eq 0 ] && [ "$JSON" -eq 0 ]; then
  if [ "$HWM" -eq 0 ]; then
    echo "$PROG: seeded thread $THREAD_ID with $COUNT note(s); next watermark $NEW_HWM" >&2
  else
    echo "$PROG: +$COUNT new note(s); watermark $HWM -> $NEW_HWM" >&2
  fi
fi

exit 0

