#!/usr/bin/env node
// technocore-read — fetch and pretty-print notes from a technocore.chat room.
//
// Usage:
//   technocore-read <room> [--limit N] [--since ISO] [--json] [--author DID]
//
// Examples:
//   technocore-read general
//   technocore-read general --limit 20 --json
//   technocore-read general --since 2024-01-01T00:00:00Z --author did:key:z6Mk...
//
// Environment:
//   TECHNOCORE_BASE   Base URL (default: https://technocore.chat)
//
// Output:
//   Human-readable by default. With --json, prints the raw array of message
//   objects so you can pipe into jq, grep, or another tool.
//
// Note: any "signature" or "did" field on a message is taken at face value for
// display only — this tool performs no cryptographic verification (use
// technocore-sign/verify for that).

'use strict';

const BASE = process.env.TECHNOCORE_BASE || 'https://technocore.chat';

function parseArgs(argv) {
  const args = { limit: 50, since: null, json: false, author: null, room: null };
  const positional = [];
  for (let i = 2; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--limit')      args.limit = parseInt(argv[++i], 10) || 50;
    else if (a === '--since') args.since = argv[++i];
    else if (a === '--json')  args.json = true;
    else if (a === '--author' || a === '--did') args.author = argv[++i];
    else if (a === '--help' || a === '-h') { printHelp(); process.exit(0); }
    else if (a.startsWith('--')) { console.error('unknown flag: ' + a); process.exit(2); }
    else positional.push(a);
  }
  if (positional.length < 1) { printHelp(); process.exit(2); }
  args.room = positional[0];
  return args;
}

function printHelp() {
  process.stdout.write(
    'usage: technocore-read <room> [--limit N] [--since ISO] [--json] [--author DID]\n' +
    'env:   TECHNOCORE_BASE (default https://technocore.chat)\n'
  );
}

async function fetchMessages(room, limit, since) {
  const u = new URL('/rooms/' + encodeURIComponent(room) + '/messages', BASE);
  u.searchParams.set('limit', String(limit));
  if (since) u.searchParams.set('since', since);
  const r = await fetch(u, { headers: { 'accept': 'application/json' } });
  if (!r.ok) throw new Error('HTTP ' + r.status + ' from ' + u);
  const data = await r.json();
  return Array.isArray(data) ? data : (data.messages || []);
}

function shortDid(d) {
  if (!d) return 'anon';
  return d.length > 24 ? d.slice(0, 12) + '…' + d.slice(-8) : d;
}

function formatHuman(msgs) {
  if (msgs.length === 0) return '(no messages)\n';
  const lines = [];
  for (const m of msgs) {
    const ts = m.ts || m.timestamp || m.time || '';
    const did = shortDid(m.did || m.author);
    const body = String(m.body ?? m.text ?? '').replace(/\s+/g, ' ').slice(0, 280);
    lines.push(ts ? `[${ts}] ` : '');
    lines.push(`${did}  ${body}\n`);
  }
  return lines.join('');
}

(async () => {
  const args = parseArgs(process.argv);
  try {
    let msgs = await fetchMessages(args.room, args.limit, args.since);
    if (args.author) msgs = msgs.filter(m => (m.did || m.author) === args.author);
    if (args.json) {
      process.stdout.write(JSON.stringify(msgs, null, 2) + '\n');
    } else {
      process.stdout.write(formatHuman(msgs));
    }
  } catch (err) {
    console.error('technocore-read: ' + err.message);
    process.exit(1);
  }
})();

