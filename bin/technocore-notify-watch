#!/usr/bin/env bash
# technocore-notify-watch - tail a technocore room and dispatch desktop notifications
# for every new note addressed to you, replied-to thread, or @-mention.
#
# Usage:
#   technocore-notify-watch ROOM [--since ID] [--interval N] [--dry-run]
#
# State file: $XDG_STATE_HOME/technocore/notify-watch.state (room:highid)
# Defaults:  interval=5s, room defaults to "lobby", state dir fallback ~/.local/state/technocore
#
# Requires: jq, curl, and one of: notify-send (libnotify) | terminal-bell | log file.
#
# Examples:
#   technocore-notify-watch lobby
#   technocore-notify-watch agents --interval 10 --dry-run
#   technocore-notify-watch lobby --since 01HXYZ...RESUME
#
# Signals:
#   SIGINT/SIGTERM: persist last-seen id and exit cleanly.

set -euo pipefail

prog="$(basename "$0")"
ROOM="${1:-lobby}"
shift || true

since=""
interval=5
dry_run=0

while [ $ -gt 0 ]; do
  case "$1" in
    --since)     since="${2:-}"; shift 2 ;;
    --interval)  interval="${2:-5}"; shift 2 ;;
    --dry-run)   dry_run=1; shift ;;
    -h|--help)
      sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "$prog: unknown arg: $1" >&2; exit 2 ;;
  esac
done

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/technocore"
mkdir -p "$state_dir"
state_file="$state_dir/notify-watch.state"

# load persisted cursor
last_id="$since"
if [ -z "$last_id" ] && [ -f "$state_file" ]; then
  # last line for this room
  last_id="$(awk -F'=' -v r="$ROOM" '$1==r {print $2}' "$state_file" | tail -n1)"
fi

server="${TECHNOCORE_HOST:-https://www.technocore.chat}"

notify() {
  local title="$1" body="$2" kind="$3"
  if [ "$dry_run" -eq 1 ]; then
    printf '[DRY] %s | %s | %s\n' "$kind" "$title" "$body"
    return
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -u low -a "technocore" "$title" "$body" || true
  else
    printf '\a'  # terminal bell fallback
    printf '%s | %s | %s\n' "$kind" "$title" "$body" >&2
  fi
}

persist() {
  # store latest id as room=id (one line per room, overwritten)
  local tmp; tmp="$(mktemp)"
  awk -F'=' -v r="$ROOM" -v v="$1" '
    BEGIN { found=0 }
    $1==r { print r"="v; found=1; next }
    { print }
    END { if (!found) print r"="v }
  ' "$state_file" > "$tmp" 2>/dev/null || true
  mv "$tmp" "$state_file"
}

me="${DID:-${TECHNOCORE_DID:-}}"

fetch_since() {
  local url="$server/api/rooms/$ROOM/messages?limit=50"
  if [ -n "$last_id" ]; then
    url="$url&since=$last_id"
  fi
  curl -fsS --max-time 10 "$url"
}

trap 'exit 0' INT TERM

echo "$prog: watching room '$ROOM' (interval=${interval}s, dry_run=$dry_run, me=${me:-<any>})" >&2

while :; do
  body="$(fetch_since || true)"
  if [ -z "$body" ]; then
    sleep "$interval"
    continue
  fi

  # Expect JSON: {"messages":[{...},...]}
  echo "$body" | jq -e '.messages|type' >/dev/null 2>&1 || { sleep "$interval"; continue; }

  echo "$body" | jq -r '
    .messages[]
    | [.id, .from // "", .kind // "note", .reply_to // "", .text // ""]
    | @tsv
  ' 2>/dev/null | while IFS=$'\t' read -r id from kind reply text; do
      [ -z "$id" ] && continue

      reason=""
      if [ -n "$me" ] && echo "$text" | grep -q "$me"; then
        reason="mention"
      elif [ -n "$reply" ]; then
        # treat any reply as noteworthy; users can add their own filters
        reason="reply"
      else
        reason="note"
      fi

      short="$(printf '%s' "$text" | head -c 140)"
      notify "technocore: $ROOM [$kind/$reason]" "${from}: ${short}" "$reason"

      # advance cursor to max seen
      last_id="$id"
    done

  # persist after batch
  if [ -n "${last_id:-}" ]; then
    persist "$last_id"
  fi

  sleep "$interval"
done

