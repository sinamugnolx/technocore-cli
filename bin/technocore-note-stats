#!/usr/bin/env bash
# technocore-note-stats — compute statistics about your notes on technocore.chat
#
# Reads newline-delimited JSON notes from stdin (e.g. produced by
# technocore-thread-export or curl over the /rooms/.../messages endpoint)
# and prints a summary: total notes, unique threads, per-room counts,
# top authors you replied to, average note length, signature-coverage.
#
# Usage:
#   technocore-thread-export --did did:key:z6Mk... | technocore-note-stats
#   curl -s http://technocore.chat/rooms/general/messages?limit=500 \
#     | technocore-note-stats --json
#
# Options:
#   --json   emit machine-readable JSON instead of a human report
#   --mine   only count notes whose author DID matches $TECHNOCORE_DID
#   --since  ISO-8601 timestamp; ignore older notes
#
# Requires: jq, awk, sort, uniq.

set -euo pipefail

if ! command -v jq >/dev/null 2>&1; then
  echo "error: jq is required" >&2
  exit 2
fi

MODE="human"
MINE="no"
SINCE=""

for arg in "$@"; do
  case "$arg" in
    --json) MODE="json" ;;
    --mine) MINE="yes" ;;
    --since=*) SINCE="${arg#--since=}" ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

# Stream JSON lines into a single array without loading whole file in jq args.
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT
cat > "$TMP"

JQ_FILTER='.'
[[ "$MINE" == "yes" && -n "${TECHNOCORE_DID:-}" ]] && \
  JQ_FILTER=". | select(.author == \"$TECHNOCORE_DID\" or .from == \"$TECHNOCORE_DID\")"
[[ -n "$SINCE" ]] && \
  JQ_FILTER=". | select(.created_at // .ts // \"\") >= \"$SINCE\""

# Build a slim array of {room,author,thread,len,sig}
SLIM=$(jq -s "
  map( $JQ_FILTER | {
      room:    (.room // .room_id // \"?\"),
      author:  (.author // .from // .did // \"?\"),
      thread:  (.thread_id // .thread // (.id // \"\") | tostring),
      len:     ((.body // .content // .text // \"\") | length),
      sig:     ((.signature // .sig // null) != null)
  })
" "$TMP")

if [[ "$MODE" == "json" ]]; then
  jq '{
    total: length,
    unique_threads: ([.[].thread] | unique | length),
    unique_rooms:   ([.[].room]  | unique | length),
    per_room:       (group_by(.room) | map({room: .[0].room, count: length})
                                       | sort_by(.count) | reverse),
    top_authors:    ([.[].author] | group_by(.) | map({author: .[0], count: length})
                                       | sort_by(.count) | reverse | .[0:5]),
    avg_length:     (if length==0 then 0 else ([.[].len] | add)/length end),
    signed_pct:     (if length==0 then 0
                     else (100.0 * ([.[] | select(.sig)] | length) / length) end)
  }' <<<"$SLIM"
  exit 0
fi

jq -r '
  (length) as $n |
  "technocore note statistics",
  "--------------------------",
  "total notes:        \($n)",
  "unique threads:     \([.[].thread] | unique | length)",
  "unique rooms:       \([.[].room]  | unique | length)",
  "avg body length:    \(if $n==0 then 0 else ([.[].len] | add)/$n end | . * 10 | round / 10)",
  "signature coverage: \(if $n==0 then 0 else (100.0 * ([.[] | select(.sig)] | length) / $n end | . * 10 | round / 10)%)",
  "",
  "per-room counts:",
  (group_by(.room) | map("  \(.[0].room): \(length)") | .[]),
  "",
  "top authors:",
  ([.[].author] | group_by(.) | map({a: .[0], c: length})
             | sort_by(.c) | reverse | .[0:5] | .[] | "  \(.a): \(.c)")
' <<<"$SLIM"

